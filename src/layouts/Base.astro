---
import "../styles/global.css";
import Icons from "../components/Icons.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Guide from "../components/Guide.astro";
import { SITE } from "../data/seo";

interface Props {
  title: string;
  description: string;
  mainClass?: string;
  // What this page is about. Read by the context script so links from here carry it forward.
  context?: { situation?: string; area?: string; building?: string };
  // Search and sharing. `image` is the share picture, `schema` is extra structured data for this page,
  // `noindex` keeps a page out of search results, `ogType` is "article" for long reads.
  image?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: "website" | "article";
}
const { title, description, mainClass, context, image = "/images/hero-liberty.jpg", schema = [], noindex = false, ogType = "website" } = Astro.props;
// One address per page: no trailing slash, to match the links used across the site.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(path, Astro.site);
const shareImage = new URL(image, Astro.site);
const org = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  logo: `${SITE.url}/apple-touch-icon.png`,
  image: `${SITE.url}/images/hero-liberty.jpg`,
  founder: { "@type": "Person", name: SITE.founder, url: `${SITE.url}/about` },
  areaServed: { "@type": "City", name: "New York", containedInPlace: { "@type": "State", name: "New York" } },
  knowsAbout: ["Manhattan real estate", "Co-ops and condominiums", "Buying an apartment in New York City", "Manhattan neighborhoods", "Residential building analysis"],
};
const website = { "@context": "https://schema.org", "@type": "WebSite", "@id": `${SITE.url}/#website`, name: SITE.name, url: SITE.url, publisher: { "@id": `${SITE.url}/#organization` } };
const blocks = [org, website, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
    <meta name="theme-color" content="#2A3447" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600&display=swap" />
    <slot name="head" />
  </head>
  <body data-ctx-situation={context?.situation} data-ctx-area={context?.area} data-ctx-building={context?.building}>
    <Icons />
    <Header />
    <main class={mainClass}><slot /></main>
    <Footer />
    <Guide />
    <script is:inline>
      // Site-wide context. The URL is the source of truth: each page reads what it was given, adds what
      // it is about (situation, area, building) when nothing is set yet, and passes every value on to
      // the links and forms it shows. A value already on a link is never overwritten, and a page with no
      // context passes nothing, so browsing stays free.
      (function () {
        var KEYS = ["situation", "decision", "building", "area", "from"];
        var here = new URL(location.href);
        var ctx = {};
        KEYS.forEach(function (k) { var v = here.searchParams.get(k); if (v) ctx[k] = v; });
        var body = document.body.dataset;
        var about = { situation: body.ctxSituation, area: body.ctxArea, building: body.ctxBuilding };
        Object.keys(about).forEach(function (k) { if (about[k] && !ctx[k]) ctx[k] = about[k]; });

        // Only the four journey keys count as context. `from` records where the journey began.
        var journey = ["situation", "decision", "building", "area"].some(function (k) { return ctx[k]; });
        if (journey && !ctx.from) ctx.from = location.pathname;
        if (!journey) return;

        function carry(href) {
          if (!href || href.charAt(0) === "#" || /^(https?:|mailto:|tel:|sms:)/.test(href)) return href;
          var u = new URL(href, location.href);
          if (u.origin !== location.origin || u.pathname.indexOf("/api/") === 0) return href;
          Object.keys(ctx).forEach(function (k) { if (!u.searchParams.has(k)) u.searchParams.set(k, ctx[k]); });
          return u.pathname + u.search + u.hash;
        }

        document.querySelectorAll("a[href]").forEach(function (a) {
          var next = carry(a.getAttribute("href"));
          if (next !== a.getAttribute("href")) a.setAttribute("href", next);
        });

        document.querySelectorAll("main form").forEach(function (f) {
          Object.keys(ctx).forEach(function (k) {
            if (f.querySelector('input[name="' + k + '"]')) return;
            var i = document.createElement("input");
            i.type = "hidden"; i.name = k; i.value = ctx[k];
            f.appendChild(i);
          });
        });
      })();
    </script>
  </body>
</html>
