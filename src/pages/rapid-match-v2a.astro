<style>
  .hero { background: radial-gradient(circle at 18% 0%, #2a3f78 0%, #17306A 38%, #0B1A44 100%); color: var(--ivory); padding: clamp(56px, 8vw, 96px) 0; border-bottom: 1px solid rgba(95, 134, 208, 0.45); }
  .hero .wrap { display: flex; flex-direction: column; gap: 26px; }
  .hero .eyebrow { color: #F6C98A; }
  h1 { margin: 0; font: 500 clamp(40px, 5.2vw, 64px)/1.02 var(--serif); color: var(--ivory); text-wrap: balance; }
  .lede { margin: 0; max-width: 60ch; font-size: 18px; line-height: 1.6; color: var(--ivory); }

  /* Three source lanes run into one engine, then out to a single match. */
  .feeds { position: relative; margin: 12px 0 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .rail { display: grid; gap: 10px; }
  .line { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; border-left: 2px solid #F6C98A; border-radius: 0 10px 10px 0; background: rgba(245, 242, 235, 0.07); }
  .line .tag { font: 600 12px/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; color: var(--champagne); }
  .line .note { font-size: 14px; line-height: 1.45; color: var(--ivory); }
  .track { display: none; }
  .engine, .result { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; border: 1px solid rgba(160, 185, 235, 0.45); border-radius: 10px; background: rgba(245, 242, 235, 0.08); color: var(--ivory); }
  .engine { align-items: center; text-align: center; border: 0; background: none; box-shadow: none; padding: 0; }
  .eng-q { width: 124px; height: 124px; border-radius: 50%; object-fit: cover; border: 2px solid #F6C98A; box-shadow: 0 0 0 6px rgba(246, 201, 138, 0.14), 0 0 34px rgba(246, 201, 138, 0.5); animation: eng-glow 2.6s ease-in-out infinite; }
  @keyframes eng-glow { 50% { box-shadow: 0 0 0 12px rgba(246, 201, 138, 0.06), 0 0 46px rgba(246, 201, 138, 0.7); } }
