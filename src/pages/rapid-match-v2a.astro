              <g><circle cx="320" cy="110" r="46" fill="none" stroke="#F6C98A" stroke-opacity=".4" class="gl"/><circle cx="320" cy="110" r="38" fill="#0B1A44" stroke="#F6C98A" stroke-width="1.8"/><image href="/images/quick-match-q-round.webp" x="284" y="74" width="72" height="72" preserveAspectRatio="xMidYMid slice"/><text x="320" y="170" text-anchor="middle" font-size="7.5" style="fill:#F5F2EB">MATCH ENGINE</text></g>
              <g transform="translate(450,92) scale(.74) translate(-450,-92)">
