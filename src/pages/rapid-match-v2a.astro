                <g transform="translate(450,50)"><g class="sheet" id="b8-sheet"><rect width="138" height="102" rx="2" fill="#fff" stroke="#d6d2c8"/>
                  <text id="b8-n" x="10" y="16" font-size="7" fill="#7b7b7b" font-family="monospace" font-weight="400" letter-spacing="0">MATCH #128</text>
                  <rect x="10" y="24" width="64" height="5" rx="1" fill="url(#b8e)"/><rect x="10" y="33" width="92" height="3" rx="1" fill="#e4e0d6"/><rect x="10" y="39" width="80" height="3" rx="1" fill="#e4e0d6"/>
                  <rect x="12" y="68" width="8" height="18" fill="#B8BBC0"/><rect x="25" y="62" width="8" height="24" fill="#8791A3"/><rect x="38" y="72" width="8" height="14" fill="#5B7494"/><rect x="51" y="58" width="8" height="28" fill="#2A3447"/><rect x="64" y="66" width="8" height="20" fill="#B08D57"/>
                  <path d="M92 64h34M92 72h28M92 80h32" stroke="#e4e0d6" stroke-width="2.5"/></g></g>
