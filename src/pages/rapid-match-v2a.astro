          </svg>
          <div class="b8-tx"><h3>3. Every listing is scored</h3><p>Closer fits rise to the top, and you see the best one with the reasons. Move across the chart to scrub.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap quiz" id="quiz" aria-labelledby="quiz-h">
    <div class="eyebrow">Four questions</div>
    <h2 id="quiz-h">Tell us what you need.</h2>

    <form id="match-form">
      <fieldset>
        <legend>Where would you live?</legend>
        <div class="opts">{hoods.map((h) => <label class="opt"><input type="radio" name="hood" value={h} required /><span>{h}</span></label>)}</div>
      </fieldset>
      <fieldset>
        <legend>How many bedrooms?</legend>
        <div class="opts">{beds.map((b) => <label class="opt"><input type="radio" name="beds" value={b} required /><span>{b === 3 ? "3 or more" : b}</span></label>)}</div>
      </fieldset>
      <fieldset>
        <legend>What is your budget?</legend>
        <div class="opts">{lanes.map((l) => <label class="opt"><input type="radio" name="lane" value={l.id} required /><span>{l.label}</span></label>)}</div>
      </fieldset>
      <fieldset>
        <legend>What must it have? (optional)</legend>
        <div class="opts">{traits.map((t) => <label class="opt"><input type="checkbox" name="trait" value={t} /><span>{t}</span></label>)}</div>
      </fieldset>
      <button class="btn" type="submit">Show my match <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></button>
    </form>

    <article id="match" class="match" hidden aria-live="polite"></article>
    <p class="small">General information only, not legal, tax or financial advice. Free to try, with no card needed.</p>
  </section>

  <section class="tl-sec" aria-labelledby="tl-h">
    <div class="wrap">
      <p class="eyebrow">After the sample</p>
      <h2 id="tl-h">Your first seven days</h2>
      <p class="tl-lede">With the team on your side, each source is read on its own rhythm and matched against your answers. This is the plan, not a live feed.</p>
      <ol class="tl" data-tl>
        <li data-tl-step>
          <span class="tl-dot" aria-hidden="true"></span>
          <div class="tl-card"><span class="tl-day">Days 1 to 2</span><h3>Off-market scan</h3><p>We ask the private network what is quietly available, and what is about to be.</p><div class="tl-meter" aria-hidden="true"><i style="--w:86%"></i></div><small>Private network · daily</small></div>
        </li>
        <li data-tl-step>
          <span class="tl-dot" aria-hidden="true"></span>
          <div class="tl-card"><span class="tl-day">Days 3 to 4</span><h3>MLS match</h3><p>New listings are matched against your answers as they appear, hour by hour.</p><div class="tl-meter" aria-hidden="true"><i style="--w:64%"></i></div><small>New listings · hourly</small></div>
        </li>
        <li data-tl-step>
          <span class="tl-dot" aria-hidden="true"></span>
          <div class="tl-card"><span class="tl-day">Days 5 to 6</span><h3>Public records check</h3><p>Ownership, permits and building history are read for every home on the short list.</p><div class="tl-meter" aria-hidden="true"><i style="--w:92%"></i></div><small>Sales, taxes, filings · weekly</small></div>
        </li>
        <li data-tl-step>
          <span class="tl-dot" aria-hidden="true"></span>
          <div class="tl-card"><span class="tl-day">Day 7</span><h3>Your report, and a tour</h3><p>Your ranked report arrives, and we book a tour of your top match with the team.</p><div class="tl-meter" aria-hidden="true"><i style="--w:100%"></i></div><small>Booked with the team</small></div>
        </li>
      </ol>
      <p class="tl-after">Then the watch continues for three months, so a home that opens next month still finds you.</p>
    </div>
  </section>
</Base>

<script>
  import { initTimeline } from "../scripts/rapid";
  initTimeline();
</script>

<script is:inline define:vars={{ listings }}>
  // Scores each sample listing against the answers. Higher is a closer fit.
  (function () {
    var form = document.getElementById("match-form");
    var out = document.getElementById("match");
    if (!form || !out) return;
    var lanesOrder = ["under3", "3to6", "6plus"];

    function score(l, a) {
      var s = 0;
      if (l.hood === a.hood) s += 3;
      if (a.beds === 3 ? l.beds >= 3 : l.beds === a.beds) s += 2;
      var gap = Math.abs(lanesOrder.indexOf(l.lane) - lanesOrder.indexOf(a.lane));
      s += gap === 0 ? 2 : gap === 1 ? 1 : 0;
      a.traits.forEach(function (t) { if (l.traits.indexOf(t) !== -1) s += 1; });
      return s;
    }

    function money(n) { return "$" + (n / 1000000).toFixed(n % 1000000 ? 2 : 1).replace(/\.?0+$/, "") + " million"; }

    function el(tag, cls, text) {
      var n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var data = new FormData(form);
      var a = {
        hood: data.get("hood"),
        beds: Number(data.get("beds")),
        lane: data.get("lane"),
        traits: data.getAll("trait"),
      };
      var ranked = listings
        .map(function (l) { return { l: l, s: score(l, a) }; })
        .sort(function (x, y) { return y.s - x.s; });
      var best = ranked[0].l;

      out.replaceChildren();
      out.append(
        el("div", "src", best.source + " · sample"),
        el("h3", "", best.address),
        el("p", "why", best.why),
        el("p", "facts", best.beds + " bedroom" + (best.beds > 1 ? "s" : "") + " · " + best.hood + " · " + money(best.price)),
        el("p", "note", "Not a live listing. Connect a feed and this card shows the real property, with its source and date.")
      );
      var inventory = el("a", "inventory");
      inventory.href = "/building-reports/individual-buildings";
      inventory.innerHTML =
        '<svg class="gem" viewBox="0 0 48 48" aria-hidden="true"><path d="M14 6h20l8 12-18 24L6 18z" fill="#2A3447"/><path d="M14 6h20l8 12H6z" fill="#3D4A60"/><path d="M24 42L14 18h20z" fill="#1E2A3A"/><path d="M6 18h36M14 6l10 12 10-12" fill="none" stroke="#B08D57" stroke-width="1"/></svg>' +
        '<span><b>Full Manhattan building inventory</b><small>Read the building reports, one address at a time.</small></span>';
      out.append(inventory);

      out.hidden = false;
      out.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  })();
</script>

