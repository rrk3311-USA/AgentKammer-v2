            <circle r="2.6" class="pk"><animateMotion dur="2.8s" begin=".4s" repeatCount="indefinite" path="M130,88 C190,88 240,110 282,110"/></circle>
            <circle r="2.6" class="pk"><animateMotion dur="2.6s" begin=".8s" repeatCount="indefinite" path="M130,138 C200,138 235,110 282,110"/></circle>
            <circle r="2.6" class="pk"><animateMotion dur="2s" repeatCount="indefinite" path="M358,110 C405,110 418,86 450,86"/></circle>
          </svg>
