---
import Base from "../layouts/Base.astro";

// Sample listings for the free preview. They are illustrative, not live MLS or off-market inventory.
const listings = [
  { id: "a", address: "Sample: West Village two-bedroom", hood: "West Village", beds: 2, price: 3800000, lane: "3to6", source: "Off-market", traits: ["Outdoor space", "Quiet street"], why: "Quiet block, two bedrooms, and a private terrace that rarely reaches the market." },
  { id: "b", address: "Sample: Chelsea one-bedroom", hood: "Chelsea", beds: 1, price: 2200000, lane: "under3", source: "MLS", traits: ["Doorman"], why: "A listed one-bedroom with a full-time doorman, close to the High Line." },
  { id: "c", address: "Sample: Tribeca loft", hood: "Tribeca", beds: 3, price: 7200000, lane: "6plus", source: "Off-market", traits: ["Outdoor space", "Park view"], why: "Three bedrooms and a park view, with room for a family office at home." },
  { id: "d", address: "Sample: Upper East Side co-op", hood: "Upper East Side", beds: 2, price: 2600000, lane: "under3", source: "MLS", traits: ["Doorman", "Park view"], why: "A listed two-bedroom near the park, in a building with a full-time staff." },
];
const hoods = ["West Village", "Chelsea", "Tribeca", "Upper East Side"];
const beds = [1, 2, 3];
const lanes = [
  { id: "under3", label: "Under $3 million" },
  { id: "3to6", label: "$3 to $6 million" },
  { id: "6plus", label: "$6 million and above" },
];
const traits = ["Outdoor space", "Doorman", "Quiet street", "Park view"];
const sources = [
  { name: "Off-market", note: "Sellers and brokers who have not listed yet" },
  { name: "MLS", note: "Listings from the regional multiple listing service" },
  { name: "Public records", note: "Ownership, permits and building history" },
];
---
<Base title="Rapid Match v2A | Agent Kammer" description="A free sample of an ideal property match, built from off-market and MLS sources. Answer a few questions to see one.">
  <section class="wrap bento8 b8" aria-labelledby="b8-h">
    <div class="b8-hd">
      <div class="eyebrow">Free sample</div>
      <h1 id="b8-h">See an ideal <em>match</em> in three minutes.</h1>
      <p class="b8-lede">We read off-market, MLS and public records together, then score them against a few answers from you. Here is how it works, then try it below. The diagrams are illustrations and the listings are samples, not a live feed.</p>
      <a class="btn" href="#quiz">Try it now <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
    </div>
    <div class="b8-grid">
      <div class="b8-fr b8-wide"><i class="b8-c tl"></i><i class="b8-c tr"></i><i class="b8-c bl"></i><i class="b8-c br"></i>
        <div class="b8-cd" style="padding:0;overflow:hidden">
          <svg viewBox="0 0 640 178" role="img" aria-label="Off-market, MLS and public records flow through the match engine into match reports">
            <defs>
              <linearGradient id="b8e" x1="0" x2="1"><stop offset="0" stop-color="#B08D57"/><stop offset="1" stop-color="#2A3447"/></linearGradient>
              <radialGradient id="b8g" cx="320" cy="110" r="190" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
            </defs>
            <rect width="640" height="178" fill="url(#b8g)"/>
            <g font-family="Inter,sans-serif" font-size="8" fill="#2F3136" font-weight="600" letter-spacing=".6">
