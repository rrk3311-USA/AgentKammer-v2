            </defs>
            <line x1="14" x2="286" y1="32" y2="32" stroke="#e4e0d6"/><line x1="14" x2="286" y1="65" y2="65" stroke="#e4e0d6"/><line x1="14" x2="286" y1="98" y2="98" stroke="#e4e0d6"/>
            <path id="b8-area" d="" fill="url(#b8a)"/><path id="b8-line" class="ln" pathLength="1" d=""/>
