---
import Base from "../../layouts/Base.astro";
import { situations, situationGroups } from "../../data/situations";

const bySlug = (slug: string) => situations.find((s) => s.slug === slug)!;
---
<Base title="What's changing | Agent Kammer" description="Start from what changed. Pick the life event closest to yours.">
  <section class="sbn" aria-label="Page title"><div class="in"><p class="sbt">Choose your <em>situation</em></p></div></section>
  <div class="wrap gh sh">
    <div class="pk-band">
    <header class="gh-head">
      <h1>Start from what changed.</h1>
    </header>

    <section class="pk" aria-labelledby="pk-q">
      <div class="pk-pick">
        <h2 id="pk-q">What is closest to your situation?</h2>
        {situationGroups.map((g) => (
          <div class="pk-grp">
            <div class="pk-k">{g.title}</div>
            <div class="pk-chips">
              {g.slugs.map((slug) => {
                const s = bySlug(slug);
                return s.ready
                  ? <a class="pk-chip" href={`/situations/${s.slug}`} data-name={s.name} data-group={g.title} data-blurb={s.blurb} data-recommend={s.recommendation ?? ""} aria-pressed="false">{s.name}</a>
                  : <span class="pk-chip soon">{s.name} <em>Soon</em></span>;
              })}
            </div>
          </div>
        ))}
      </div>
      <aside class="pk-pv" id="pk-pv" aria-live="polite">
        <span class="pk-k" id="pk-pg">Pick a situation</span>
        <h3 id="pk-pn">Start with what changed.</h3>
        <p id="pk-pb">Choose the life event closest to yours and we show what that page covers.</p>
        <p class="pk-rec" id="pk-pr" hidden></p>
        <a class="pk-go" id="pk-pa" href="/belonging" hidden>Read this situation <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
      </aside>
    </section>
    </div>

    <div class="gcta">
      <h2>Not sure which one is yours?</h2>
      <p>Share what changed, and we send back a personal profile of where you stand.</p>
      <a class="btn" href="/belonging">Request a Situation Assessment <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
    </div>
  </div>
</Base>

<style is:global>
/* Situations banner: page title on a cream underlay, platinum line at the side */
.sbn{position:relative;min-height:clamp(220px,26vw,340px);display:flex;align-items:flex-end;padding:clamp(12px,2.4vw,28px) clamp(16px,6vw,72px) 0;background:var(--stone-blue) url(/images/situations-banner-terrace.jpg) 12% 38%/cover no-repeat}
.sbn .in{position:relative;max-width:min(560px,100%);padding:clamp(16px,2.4vw,30px) clamp(28px,4vw,52px) clamp(14px,2vw,24px) clamp(18px,2.4vw,30px);background:linear-gradient(180deg,rgba(251,246,238,.72) 0%,rgba(245,242,235,.96) 38%,#F5F2EB 62%);-webkit-backdrop-filter:blur(5px);backdrop-filter:blur(5px);box-shadow:inset 0 1px 0 rgba(255,255,255,.75);border:1px solid #B8BBC0;border-bottom:0;border-radius:16px 16px 0 0;margin-bottom:-1px}
.sbn .in::after{content:"";position:absolute;bottom:0;right:-16px;width:16px;height:16px;background:radial-gradient(circle at 100% 0,transparent 15px,#F5F2EB 15.5px)}
.sbn .sbt{margin:0;font:500 clamp(30px,4.4vw,56px)/1 var(--serif);letter-spacing:-.012em;color:var(--stone-blue)}
.sbn .sbt em{font-style:italic;font-weight:400}
</style>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll(".pk-chip[data-name]");
    if (!chips.length) return;
    var g = function (i) { return document.getElementById(i); };
    function show(c) {
      Array.prototype.forEach.call(chips, function (x) { x.setAttribute("aria-pressed", x === c ? "true" : "false"); });
      g("pk-pg").textContent = c.dataset.group;
      g("pk-pn").textContent = c.dataset.name;
      g("pk-pb").textContent = c.dataset.blurb;
      var r = g("pk-pr"); r.textContent = c.dataset.recommend; r.hidden = !c.dataset.recommend;
      var a = g("pk-pa"); a.href = c.getAttribute("href"); a.hidden = false;
      document.getElementById("pk-pv").classList.add("on");
    }
    Array.prototype.forEach.call(chips, function (c) {
      c.addEventListener("click", function (e) { e.preventDefault(); show(c); });
    });
    show(chips[0]);
  })();
</script>

