---
import Base from "../../layouts/Base.astro";
import { neighborhoods, neighborhoodTitle, buildingsIn } from "../../data/neighborhoods";
import { breadcrumbSchema, faqSchema, placeSchema } from "../../data/seo";
import { situations, decisionChoices } from "../../data/situations";
import { condoVsCoop, coopTerms } from "../../data/guidePages";

export function getStaticPaths() {
  return [
    ...neighborhoods.map((n) => ({ params: { slug: n.slug }, props: { kind: "n", n } })),
    ...situations.filter((s) => s.ready).map((s) => ({ params: { slug: s.slug }, props: { kind: "s", s } })),
    { params: { slug: condoVsCoop.slug }, props: { kind: "g", g: condoVsCoop } },
    { params: { slug: coopTerms.slug }, props: { kind: "g", g: coopTerms } },
  ];
}
const { kind, n, s, g } = Astro.props as any;
const others = kind === "n" ? n.compare.map((x: string) => neighborhoods.find((y) => y.slug === x)!) : [];
const related = kind === "s" ? s.related.map((x: string) => situations.find((y) => y.slug === x)!) : [];
const here = Astro.url.pathname.replace(/\/+$/, "");
const bld = kind === "n" ? buildingsIn(n) : { profiles: [], library: [] };
const schema = kind === "n"
  ? [
      breadcrumbSchema([{ name: "Insights", href: "/guides" }, { name: "Neighborhoods", href: "/neighborhoods" }, { name: n.name, href: here }]),
      placeSchema({ name: n.name, description: n.metaDescription, path: here }),
      faqSchema(n.faq),
    ]
  : kind === "s"
    ? [breadcrumbSchema([{ name: "What's changing", href: "/situations" }, { name: s.name, href: here }])]
    : [breadcrumbSchema([{ name: "Insights", href: "/guides" }, { name: g.title, href: here }])];
const title = kind === "n" ? `${neighborhoodTitle(n)} | Agent Kammer` : kind === "g" ? `${g.title} | Agent Kammer` : `${s.title} | Agent Kammer`;
const description = kind === "n" ? n.metaDescription : kind === "g" ? g.blurb : s.blurb;
---
<Base title={title} description={description} schema={schema} context={kind === "n" ? { area: n.name } : kind === "s" ? { situation: s.name } : {}}>
  {kind === "n" ? (
    <article class="wrap nb">
      <header>
        <div class="eyebrow">Manhattan neighborhood guide</div>
        <h1>Buying in {n.inName}</h1>
        <p class="lede">{n.lead}</p>
      </header>

      <section class="nb-text" aria-labelledby="nw">
        <h2 id="nw">Where it is</h2>
        <p>{n.where}</p>
        <p><b>Getting around.</b> {n.transit}</p>
      </section>

      <section class="nb-text" aria-labelledby="ns">
        <h2 id="ns">What you will find to buy</h2>
        <ul>{n.stock.map((d: string) => <li>{d}</li>)}</ul>
      </section>

      <section class="nb-two">
        <div class="nb-text">
          <h2>Who it suits</h2>
          <ul>{n.suits.map((d: string) => <li>{d}</li>)}</ul>
        </div>
        <div class="nb-text">
          <h2>What you trade</h2>
          <ul>{n.tradeoffs.map((d: string) => <li>{d}</li>)}</ul>
        </div>
      </section>

      <section class="nb-decide" aria-labelledby="nd">
        <h2 id="nd">Decide first</h2>
        <ol>
          {n.decide.map((d: string) => <li>{d}</li>)}
        </ol>
      </section>

      <section class="nb-rec" aria-labelledby="nr">
        <div class="k" id="nr">Recommendation</div>
        <p>{n.recommendation}</p>
      </section>

      {(bld.profiles.length > 0 || bld.library.length > 0) && (
        <section class="nb-bld" aria-labelledby="nbb">
          <h2 id="nbb">Buildings we cover in {n.inName}</h2>
          {bld.profiles.length > 0 && (
            <ul class="nb-links">
              {bld.profiles.map((b: any) => <li><a href={b.href}>{b.name}<span>Building profile</span></a></li>)}
            </ul>
          )}
          {bld.library.length > 0 && (
            <p class="nb-lib"><b>Also in our reference library:</b> {bld.library.join(", ")}. <a href="/contact?intent=property">Ask for a read on any of them.</a></p>
          )}
        </section>
      )}

      <section class="nb-faq" aria-labelledby="nq">
        <h2 id="nq">Questions buyers ask about {n.inName}</h2>
        <dl>
          {n.faq.map((f: any) => <><dt>{f.q}</dt><dd>{f.a}</dd></>)}
        </dl>
      </section>

      {others.length > 0 && (
        <section class="nb-compare" aria-labelledby="nc">
          <h2 id="nc">Compare with</h2>
          <ul>
            {others.map((o: any) => <li><a href={`/situations/${o.slug}`}><b>{o.name}</b><span>{o.blurb}</span></a></li>)}
          </ul>
        </section>
      )}

      <div class="gcta">
        <p>Ready for a read on your own situation?</p>
        <div class="btns">
          <a class="btn" href="/belonging">Request a Situation Assessment <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
          <a class="btn ghost" href="/neighborhoods">All neighborhoods <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
        </div>
      </div>

      <nav class="crumb" aria-label="Breadcrumb"><a href="/guides">Insights</a><i aria-hidden="true">/</i><a href="/neighborhoods">Neighborhoods</a><i aria-hidden="true">/</i><span>{n.name}</span></nav>

      <p class="gd-note">General information, not legal, tax or financial advice.</p>
    </article>
  ) : kind === "g" ? (
    <article class="wrap nb gd">
      <header>
        <div class="eyebrow">Field guide</div>
        <h1>{g.title}</h1>
        <p class="lede">{g.lead}</p>
      </header>

      {g.rows && (
        <section class="gd-table" aria-labelledby="gt">
          <h2 id="gt">Side by side</h2>
          <div class="gd-scroll">
            <table>
              <thead><tr><th scope="col"></th><th scope="col">Co-op</th><th scope="col">Condo</th></tr></thead>
              <tbody>
                {g.rows.map((r: any) => <tr><th scope="row">{r.label}</th><td>{r.coop}</td><td>{r.condo}</td></tr>)}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {g.decide && (
        <section class="nb-decide" aria-labelledby="gd1">
          <h2 id="gd1">Decide first</h2>
          <ol>{g.decide.map((d: string) => <li>{d}</li>)}</ol>
        </section>
      )}

      {g.recommendation && (
        <section class="nb-rec" aria-labelledby="gr">
          <div class="k" id="gr">Recommendation</div>
          <p>{g.recommendation}</p>
        </section>
      )}

      {g.terms && (
        <section class="gd-terms" aria-labelledby="gtm">
          <h2 id="gtm">The terms</h2>
          <dl>
            {g.terms.map((t: any) => <><dt>{t.term}</dt><dd>{t.text}</dd></>)}
          </dl>
        </section>
      )}


      <div class="gcta">
        <p>Want a read on your own building?</p>
        <div class="btns">
          <a class="btn" href="/belonging">Request a Situation Assessment <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
          <a class="btn ghost" href="/guides#field-guides">All field guides <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
        </div>
      </div>
    
      <nav class="crumb" aria-label="Breadcrumb"><a href="/guides#field-guides">Insights</a><i aria-hidden="true">/</i><a href="/guides#field-guides">Field Guides</a></nav>
    
      <p class="gd-note">General information, not legal, tax or financial advice. Confirm details with your attorney.</p>
    </article>
  ) : (
    <article class="wrap nb sit">
      <header>
        <div class="eyebrow">What's changing</div>
        <h1>{s.title}</h1>
        <p class="lede">{s.lead}</p>
      </header>

      <section class="nb-decide" aria-labelledby="sm">
        <h2 id="sm">What usually matters</h2>
        <ol>
          {s.matters.map((d: string) => <li>{d}</li>)}
        </ol>
      </section>

      <section class="nb-rec" aria-labelledby="sr">
        <div class="k" id="sr">Recommendation</div>
        <p>{s.recommendation}</p>
      </section>

      <section class="sit-pick" aria-labelledby="sp">
        <h2 id="sp">What decision are you facing?</h2>
        <ul>
          {decisionChoices.map((d) => (
            <li><a href={`/belonging?situation=${encodeURIComponent(s.name)}&decision=${encodeURIComponent(d.value)}`}>{d.label}<svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a></li>
          ))}
        </ul>
      </section>

      {related.length > 0 && (
        <section class="nb-compare" aria-labelledby="sx">
          <h2 id="sx">Often read together</h2>
          <ul>
            {related.map((o: any) => <li><a href={`/situations/${o.slug}`}><b>{o.name}</b><span>{o.blurb}</span></a></li>)}
          </ul>
        </section>
      )}


      <div class="gcta">
        <p>Ready for a read on your own situation?</p>
        <div class="btns">
          <a class="btn" href={`/belonging?situation=${encodeURIComponent(s.name)}`}>Request a Situation Assessment <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
          <a class="btn ghost" href="/situations">All situations <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
        </div>
      </div>
    
      <nav class="crumb" aria-label="Breadcrumb"><a href="/situations">What's changing</a><i aria-hidden="true">/</i><span>{s.name}</span></nav>
    
      <p class="gd-note">General information, not legal, tax or financial advice.</p>
    </article>
  )}
</Base>
