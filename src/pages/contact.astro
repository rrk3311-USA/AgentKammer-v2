---
import Base from "../layouts/Base.astro";
import "../styles/platinum-paper.css";

const decisions = ["Buy", "Sell", "Rent", "Wait / stay put", "Renew lease", "Renovate", "Refinance", "Sell or keep", "Rent current home", "Situation Assessment", "Not sure yet"];
const timelines = ["Now / 30 days", "1-3 months", "3-6 months", "6+ months", "Just exploring"];
const nexts = ["Guidance", "Situation Assessment", "Property Assessment", "Livability Score", "Not sure"];
---
<Base mainClass="pp" title="Tell us the next step | Agent Kammer" description="Share what is changing and which step you want: Guidance, Situation Assessment, Property Assessment, or a Livability Score.">
  <div class="wrap contact">
    <section class="intro">
      <div class="eyebrow">Begin</div>
      <h1>Tell us the next step.</h1>
      <p class="lede">Share what is changing and which step you want: Guidance, Situation Assessment, Property Assessment, or a Livability Score.</p>
      <ul class="alt">
        <li><a href="/guides">Prefer to read first? Open Insights <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a></li>
        <li><a href="/belonging">Prefer the Situation Assessment? Request one <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a></li>
      </ul>
    </section>

    <section class="formcol" aria-labelledby="ct">
      <div class="eyebrow">New York, New York</div>
      <h2 id="ct">Use the request form when there is enough context to respond well.</h2>
      <p class="note">A few filters keep the first reply useful: what changed, what decision is on the table, timing, and the best next step.</p>
      <form method="post" action="/api/contact">
        <input type="hidden" name="form" value="Contact" />
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        <label>Phone (optional)<input name="phone" type="tel" autocomplete="tel" /></label>
        <label>What changed?<textarea name="changed" rows="3" required></textarea></label>
        <div class="row">
          <label>Decision on the table
            <select name="decision" required><option value="">Choose one</option>{decisions.map((d) => <option>{d}</option>)}</select>
          </label>
          <label>Timeline
            <select name="timeline" required><option value="">Choose one</option>{timelines.map((d) => <option>{d}</option>)}</select>
          </label>
        </div>
        <label>What you want next
          <select name="next" required><option value="">Choose one</option>{nexts.map((d) => <option>{d}</option>)}</select>
        </label>
        <label>Anything else I should know?<textarea name="more" rows="3"></textarea></label>
        <button class="btn" type="submit">Send the next step <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></button>
      </form>
    </section>
  </div>
</Base>

<script is:inline>
  // Arriving from a page with context: fill in what changed, the decision and the next step, so nobody retypes them.
  // decision = the choice on the table. next = the step they want. intent=property comes from building pages.
  (function () {
    var q = new URLSearchParams(location.search);
    var form = document.querySelector("form");
    if (!form) return;
    var sit = q.get("situation"), dec = q.get("decision"), building = q.get("building");
    var intent = q.get("intent");
    var nextFor = { Guidance: "Guidance", "Situation Assessment": "Situation Assessment", Property: "Property Assessment", "Property Assessment": "Property Assessment" };
    var next = nextFor[q.get("next")] || (intent === "property" ? "Property Assessment" : "");

    if (dec) {
      var sel = form.querySelector('select[name="decision"]');
      if (sel) [].forEach.call(sel.options, function (o) { if (o.text === dec) sel.value = o.value || o.text; });
    }
    if (next) {
      var nextSel = form.querySelector('select[name="next"]');
      if (nextSel && !nextSel.value) nextSel.value = next;
    }
    if (intent === "property") {
      var formName = form.querySelector('input[name="form"]');
      if (formName) formName.value = "Property Inquiry";
    }
    var ta = form.querySelector('textarea[name="changed"]');
    var lead = building || sit;
    if (ta && lead && !ta.value) ta.value = lead + ": ";
  })();
</script>
