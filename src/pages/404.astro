---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found | Agent Kammer" description="That page does not exist. Start from what changed, or write to us directly.">
  <section class="wrap nf">
    <div class="eyebrow">Page not found</div>
    <h1>We could not find that page.</h1>
    <p>The link may be old, or the address may be mistyped. Start from what changed, or browse the Resource Hub.</p>
    <div class="btns">
      <a class="btn" href="/situations">Start from what changed <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
      <a class="btn ghost" href="/guides">Resource Hub <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
    </div>
  </section>
</Base>
