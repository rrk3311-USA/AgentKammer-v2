<script is:inline define:vars={{ listings }}>
  // Scores each sample listing against the answers. Higher is a closer fit.
  (function () {
    var form = document.getElementById("match-form");
    var out = document.getElementById("match");
    if (!form || !out) return;
    var lanesOrder = ["under3", "3to6", "6plus"];

    function score(l, a) {
      var s = 0;
      if (l.hood === a.hood) s += 3;
      if (a.beds === 3 ? l.beds >= 3 : l.beds === a.beds) s += 2;
      var gap = Math.abs(lanesOrder.indexOf(l.lane) - lanesOrder.indexOf(a.lane));
      s += gap === 0 ? 2 : gap === 1 ? 1 : 0;
      a.traits.forEach(function (t) { if (l.traits.indexOf(t) !== -1) s += 1; });
      return s;
    }

    function money(n) { return "$" + (n / 1000000).toFixed(n % 1000000 ? 2 : 1).replace(/\.?0+$/, "") + " million"; }

    function el(tag, cls, text) {
      var n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var data = new FormData(form);
      var a = {
        hood: data.get("hood"),
        beds: Number(data.get("beds")),
        lane: data.get("lane"),
        traits: data.getAll("trait"),
      };
      var ranked = listings
        .map(function (l) { return { l: l, s: score(l, a) }; })
        .sort(function (x, y) { return y.s - x.s; });
      var best = ranked[0].l;

      out.replaceChildren();
      out.append(
        el("div", "src", best.source + " · sample"),
        el("h3", "", best.address),
        el("p", "why", best.why),
        el("p", "facts", best.beds + " bedroom" + (best.beds > 1 ? "s" : "") + " · " + best.hood + " · " + money(best.price)),
        el("p", "note", "Not a live listing. Connect a feed and this card shows the real property, with its source and date.")
      );
      var inventory = el("a", "inventory");
      inventory.href = "/building-reports/individual-buildings";
      inventory.innerHTML =
        '<svg class="gem" viewBox="0 0 48 48" aria-hidden="true"><path d="M14 6h20l8 12-18 24L6 18z" fill="#2A3447"/><path d="M14 6h20l8 12H6z" fill="#3D4A60"/><path d="M24 42L14 18h20z" fill="#1E2A3A"/><path d="M6 18h36M14 6l10 12 10-12" fill="none" stroke="#B08D57" stroke-width="1"/></svg>' +
        '<span><b>Full Manhattan building inventory</b><small>Read the building reports, one address at a time.</small></span>';
      out.append(inventory);
      var nx = el("div", "after");
      nx.innerHTML = '<b>This was the free sample.</b><span>Your personalized Kammer Report names real buildings and homes, with sources, dates and the reasons behind each ranking.</span><a class="btn" href="/contact?intent=property">Request my Kammer Report</a>';
      out.append(nx);

      out.hidden = false;
      out.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  })();
</script>

