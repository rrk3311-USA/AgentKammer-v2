---
import Base from "../layouts/Base.astro";
import "../styles/platinum-paper.css";

const areas = [
  { name: "Upper West Side", href: "/situations/upper-west-side-buyers-nyc", d: "Schools, park adjacency, co-op culture, and classic residential rhythm. Strong for families who want daily life west of the park before chasing inventory." },
  { name: "Upper East Side", href: "/situations/upper-east-side-buyers-nyc", d: "Deep inventory with nuanced co-op boards, service buildings, and family-oriented tradeoffs across quieter side streets and avenues." },
  { name: "Tribeca", href: "/situations/tribeca-buyers-nyc", d: "Low-volume, high-conviction buying shaped by loft scale, privacy, and family floor plans. Architecture appeal must still survive ownership practicality." },
  { name: "Chelsea", href: "/situations/chelsea-buyers-nyc", d: "Gallery adjacency, West Chelsea new product, High Line access, and design-forward towers that still need lifestyle filters." },
  { name: "Hudson Yards", href: "/situations/hudson-yards-buyers-nyc", d: "Amenity-heavy new development that still needs commute, carrying-cost, and use-case pressure testing against Chelsea and Tribeca alternatives." },
  { name: "Financial District", href: "/situations/financial-district-buyers-nyc", d: "Commute convenience versus weekend livability across conversions, waterfront stock, and Battery Park City options." },
];
---
<Base mainClass="pp" title="Guides | Agent Kammer" description="Neighborhoods first. Then a Situation Assessment if you want a structured read.">
  <article class="wrap legal-page about">
    <header>
      <div class="eyebrow">Guides</div>
      <h1>Decide the frame before the listing.</h1>
      <p class="lede">Neighborhoods first. Then a Situation Assessment if you want a structured read. Field guides and Property Assessments sit on the Resource Hub.</p>
      <p class="upd"><a href="#neighborhoods">Neighborhoods</a> &nbsp;·&nbsp; <a href="/resources#field-guides">Field guides</a> &nbsp;·&nbsp; <a href="/resources#assessments">Property Assessments</a></p>
    </header>
    <div class="body">
      <section id="neighborhoods">
        <div><div class="k">Neighborhoods</div><h2>Geography before inventory.</h2></div>
        <div class="txt">
          <p>Tribeca, Chelsea, Hudson Yards, the Upper West Side, and the other Manhattan Situations. Lock one or two districts before comparing buildings.</p>
          <ul class="areas">
            {areas.map((a) => <li><a href={a.href}><b>{a.name}</b><span>{a.d}</span></a></li>)}
          </ul>
        </div>
      </section>
      <section>
        <div><div class="k">Assessment</div><h2>If you want a structured answer.</h2></div>
        <div class="txt">
          <p>Guides stay the research library. The Situation Assessment is how you figure out your situation.</p>
          <div class="btns"><a class="btn" href="/contact">Request a Situation Assessment <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a></div>
        </div>
      </section>
    </div>
  </article>
</Base>
