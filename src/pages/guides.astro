---
import Base from "../layouts/Base.astro";
import { guideItems, guideTabs } from "../data/guides";

const topics = (type: string) => [...new Set(guideItems.filter((g) => g.type === type).map((g) => g.topic))];
const count = (type: string) => guideItems.filter((g) => g.type === type).length;
---
<Base title="Resource Hub | Agent Kammer" description="Neighborhoods, field guides and property assessments in one place. Search all of it.">
  <div class="wrap gh">
    <h1 class="gh-sr">Resource Hub</h1>
    <figure class="gh-banner">
      <img src="/images/guides-banner.webp" width="2000" height="588" alt="Curved glass tower against a clear teal sky" fetchpriority="high" decoding="async" />
      <div class="gtabs" role="tablist" aria-label="Guide types">
        {guideTabs.map((t, i) => (
          <button class="gtab" role="tab" type="button" data-t={t.type} data-hash={t.hash} aria-selected={i === 0 ? "true" : "false"}>
            {t.label}<span class="n">{count(t.type)}</span>
          </button>
        ))}
      </div>
    </figure>

    <div class="gdark"><div class="gdark-in">
    <div class="gbody">
      <aside class="grail" aria-label="Topics">
        {guideTabs.map((t, i) => (
          <nav class="gtopics" data-for={t.type} hidden={i !== 0}>
            <h2>Topic</h2>
            <button type="button" class="gf" data-f="All" aria-pressed="true">All</button>
            {topics(t.type).map((tp) => <button type="button" class="gf" data-f={tp} aria-pressed="false">{tp}</button>)}
          </nav>
        ))}
      </aside>

      <div class="gmain">
        <label class="gsearch">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
          <input id="gq" type="search" placeholder="Search all guides: co-op, mortgage, Chelsea" aria-label="Search all guides" autocomplete="off" />
        </label>
        <p class="gcount" id="gcount" aria-live="polite"></p>
        <div class="glist" id="glist">
          {guideItems.map((g) => {
            const inner = (
              <>
                <span class="k">{g.topic}</span>
                <span class="t">{g.title}</span>
                <span class="m">{g.ready ? g.meta : "Coming soon"}</span>
                <span class="d">{g.text}</span>
              </>
            );
            const search = `${g.topic} ${g.title} ${g.text} ${g.meta}`.toLowerCase();
            return g.ready
              ? <a class="grow" href={g.href} data-type={g.type} data-topic={g.topic} data-s={search}>{inner}</a>
              : <div class="grow soon" data-type={g.type} data-topic={g.topic} data-s={search}>{inner}</div>;
          })}
        </div>
        <p class="gnone" id="gnone" hidden>Nothing matches that. Try co-op, mortgage or Chelsea.</p>
      </div>
    </div>

    </div></div>

    <div class="gcta">
      <h2>Want a structured read on your own situation?</h2>
      <p>Share what changed, and we send back a personal profile of where you stand.</p>
      <a class="btn" href="/contact">Request a Situation Assessment <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
    </div>
  </div>
</Base>

<script is:inline>
  (function () {
    var root = document.querySelector(".gh");
    root.classList.add("js");
    var tabs = [].slice.call(root.querySelectorAll(".gtab"));
    var rows = [].slice.call(root.querySelectorAll(".grow"));
    var groups = [].slice.call(root.querySelectorAll(".gtopics"));
    var input = document.getElementById("gq");
    var count = document.getElementById("gcount");
    var none = document.getElementById("gnone");
    var names = { n: "neighborhoods", f: "field guides", a: "property assessments" };
    var st = { t: tabs[0].getAttribute("data-t"), f: "All", q: "" };
    var byHash = { neighborhoods: "n", "field-guides": "f", assessments: "a" };
    var h = (location.hash || "").slice(1);
    if (byHash[h]) st.t = byHash[h];

    function render() {
      var q = st.q.trim().toLowerCase();
      var shown = 0;
      var perType = { n: 0, f: 0, a: 0 };
      rows.forEach(function (r) {
        var match = !q || r.getAttribute("data-s").indexOf(q) > -1;
        if (match) perType[r.getAttribute("data-type")]++;
        var vis = q ? match : r.getAttribute("data-type") === st.t && (st.f === "All" || r.getAttribute("data-topic") === st.f);
        r.hidden = !vis;
        if (vis) shown++;
        // show the type name on each row while searching across everything
        var k = r.querySelector(".k");
        if (!k.getAttribute("data-topic-text")) k.setAttribute("data-topic-text", k.textContent);
        k.textContent = q ? names[r.getAttribute("data-type")].replace(/s$/, "") + " · " + k.getAttribute("data-topic-text") : k.getAttribute("data-topic-text");
      });
      tabs.forEach(function (b) {
        var on = b.getAttribute("data-t") === st.t && !q;
        b.setAttribute("aria-selected", on ? "true" : "false");
        b.querySelector(".n").textContent = q ? perType[b.getAttribute("data-t")] : rows.filter(function (r) { return r.getAttribute("data-type") === b.getAttribute("data-t"); }).length;
      });
      groups.forEach(function (g) { g.hidden = !!q || g.getAttribute("data-for") !== st.t; });
      [].slice.call(root.querySelectorAll(".gf")).forEach(function (b) {
        b.setAttribute("aria-pressed", b.getAttribute("data-f") === st.f ? "true" : "false");
      });
      none.hidden = shown > 0;
      count.textContent = q ? shown + " result" + (shown === 1 ? "" : "s") + " across everything" : "";
    }

    tabs.forEach(function (b) {
      b.addEventListener("click", function () {
        st.t = b.getAttribute("data-t"); st.f = "All"; st.q = ""; input.value = "";
        try { history.replaceState(null, "", "#" + b.getAttribute("data-hash")); } catch (e) {}
        render();
      });
    });
    root.addEventListener("click", function (e) {
      var b = e.target.closest(".gf");
      if (b) { st.f = b.getAttribute("data-f"); render(); }
    });
    input.addEventListener("input", function () { st.q = input.value; render(); });
    render();
  })();
</script>
