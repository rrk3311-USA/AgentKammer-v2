---
import Base from "../layouts/Base.astro";
import StatsBand from "../components/rapid/StatsBand.astro";
import ScanRun from "../components/rapid/ScanRun.astro";
import Promises from "../components/rapid/Promises.astro";
import ValueStack from "../components/rapid/ValueStack.astro";
import ReportQuiz from "../components/rapid/ReportQuiz.astro";
import { buildingLibrary } from "../data/buildingLibrary";
import "../styles/rapid-v2.css";

// Draft copy in a direct-response voice, for review. The letter is signed in the owner's name: confirm before launch.
const names = buildingLibrary.map((b) => b.name);
const ticker = [...names.slice(0, 24), ...names.slice(0, 24)];
---
<Base title="Rapid Match v2B | Agent Kammer" description="Answer four questions and see the Manhattan homes we would show you first, across four price points and a three month outlook.">
  <div class="rv rv-light b2">

    <section class="rv-sec b2-hero">
      <div class="rv-wrap b2-hero-g">
        <div class="b2-hero-t">
          <p class="rv-eyebrow" data-reveal>Free sample · one minute</p>
          <h1 class="rv-h1" data-reveal style="--d:80ms">Tell us how you want to live. We'll tell you <span class="rv-mark">where to look, what to pay and when to move.</span></h1>
          <p class="rv-lede" data-reveal style="--d:160ms">No questionnaire. No four hundred listings. Rapid Match starts from your life goals and tells you the answer: a ranked report across four price points, projected across the next three months of the market.</p>
          <div class="b2-cta" data-reveal style="--d:240ms">
            <a class="rv-btn" href="#quiz">Choose my life goals <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
            <p class="rv-micro">Free. About a minute. No card. We never call unless you ask.</p>
          </div>
        </div>
        <div class="b2-hero-v" data-reveal style="--d:200ms"><ScanRun /></div>
      </div>
    </section>

    <section class="rv-wrap b2-stats"><StatsBand /></section>

    <section class="rv-sec b2-letter" aria-labelledby="b2-l">
      <div class="rv-wrap">
        <div class="b2-letter-c">
          <p class="rv-eyebrow" data-reveal>A note before you start</p>
          <h2 class="rv-h2" id="b2-l" data-reveal>Here's the problem with searching the usual way.</h2>
          <div class="b2-prose">
            <p data-reveal>Dear future Manhattan homeowner,</p>
            <p data-reveal>Let me guess how your search is going. You have three tabs open. You have set a price. You scroll, and somewhere around listing number forty the apartments begin to blur together.</p>
            <p data-reveal>Here is what rarely gets said out loud: by the time a home reaches those tabs, a small circle of people has often seen it already. Some of the best homes in Manhattan change hands without ever being listed. The rest are listed for days. Neither one arrives labelled <em>the right one for you</em>.</p>
            <p data-reveal>So I built Rapid Match around a different question. Not <em>what is for sale?</em> but <em>what is likely to be open to you, at which price, over the next three months, for the life you actually want?</em></p>
            <p data-reveal>It reads off-market sources, the MLS, public records, new development, pre-development and cash discounts together. It checks them against the buildings we have studied, <strong>{buildingLibrary.length} so far</strong> and more on the way, and against your answers. Then it hands you a short report.</p>
            <p data-reveal><strong>One best fit at the top.</strong> Four price points, so you can see what each step up buys. A three month outlook, so you know when to move and when to wait. And the reasons, in plain English, for every ranking.</p>
            <p data-reveal>Choose what you want your life to look like, and we tell you the answer. It takes about a minute, costs nothing and asks for no card.</p>
            <p class="b2-sign" data-reveal>Raphael Kammer<span>Agent Kammer</span></p>
          </div>
        </div>
      </div>
    </section>

    <section class="rv-sec b2-inside" aria-labelledby="b2-i">
      <div class="rv-wrap">
        <div class="rv-head">
          <p class="rv-eyebrow" data-reveal>What is in your report</p>
          <h2 class="rv-h2" id="b2-i" data-reveal>An expansive report, not a list.</h2>
          <p class="rv-lede" data-reveal>Every report is built from the same four parts. Here they are, in miniature.</p>
        </div>
        <div class="b2-grid">
          <article class="rv-card" data-spot data-reveal>
            <span class="rq-k">01 · Price points</span>
            <h3>Four price points, side by side</h3>
            <p>See what the entry, core, stretch and ceiling of your range each buy.</p>
            <div class="b2-v b2-v-tiers" aria-hidden="true">
              <i style="--h:34%"><b>Entry</b></i><i style="--h:52%"><b>Core</b></i><i style="--h:74%"><b>Stretch</b></i><i style="--h:92%"><b>Ceiling</b></i>
            </div>
          </article>
          <article class="rv-card" data-spot data-reveal style="--d:90ms">
            <span class="rq-k">02 · Lifestyle goals</span>
            <h3>Ranked around how you live</h3>
            <p>Quiet, entertaining, outdoor space, commute, family, services. You set the order.</p>
            <div class="b2-v b2-v-goals" aria-hidden="true">
              <span>Quiet and calm</span><span>Room to entertain</span><span>Outdoor space</span><span>Short commute</span><span>Family-ready</span><span>Full services</span>
            </div>
          </article>
          <article class="rv-card" data-spot data-reveal style="--d:180ms">
            <span class="rq-k">03 · Three month outlook</span>
            <h3>When homes are likely to come up</h3>
            <p>A month by month view of what may open to you, so timing is a decision and not a guess.</p>
            <div class="b2-v b2-v-months" aria-hidden="true">
              <span><i style="--h:44%"></i><em>Month 1</em></span><span><i style="--h:78%"></i><em>Month 2</em></span><span><i style="--h:58%"></i><em>Month 3</em></span>
            </div>
          </article>
          <article class="rv-card" data-spot data-reveal style="--d:270ms">
            <span class="rq-k">04 · The building behind each home</span>
            <h3>Checked against {buildingLibrary.length} studied buildings</h3>
            <p>Rules, finances and daily life, drawn from a reference library that keeps growing.</p>
            <div class="b2-v b2-v-lib" aria-hidden="true"><div class="b2-tick">{ticker.map((n) => <span>{n}</span>)}</div></div>
          </article>
        </div>
      </div>
    </section>

    <section class="b2-how" aria-labelledby="b2-h">
      <div class="rv-wrap">
        <div class="rv-head">
          <p class="rv-eyebrow" data-reveal>How it works</p>
          <h2 class="rv-h2 b2-hh" id="b2-h" data-reveal><img class="b2-hl" src="/images/quick-match-q.webp" alt="" width="48" height="48" />Six feeds in. One report out.</h2>
        </div>
        <div class="b2-beam" data-reveal>
          <svg viewBox="0 0 960 430" role="img" aria-label="Six feeds flow along conduits into one match engine, which sends a multi-page report through a receiving conduit">
            <defs>
              <filter id="b2glow" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="2.6" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
              <filter id="b2glow2" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="10"/></filter>
              <radialGradient id="b2core" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#FFE2B0"/><stop offset=".38" stop-color="#FFA94D"/><stop offset=".72" stop-color="#E8650F"/><stop offset="1" stop-color="#7A2300" stop-opacity="0"/></radialGradient>
              <linearGradient id="b2pipe" x1="0" x2="1"><stop offset="0" stop-color="#E3A25C" stop-opacity="0"/><stop offset=".5" stop-color="#F0C48C"/><stop offset="1" stop-color="#E3A25C" stop-opacity="0"/></linearGradient>
              <radialGradient id="b2gloss" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#1B1C22"/><stop offset=".82" stop-color="#0B0B0E" stop-opacity=".95"/><stop offset="1" stop-color="#0B0B0E" stop-opacity="0"/></radialGradient>
              <linearGradient id="b2trim" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6E707A"/><stop offset=".18" stop-color="#16171C"/><stop offset=".6" stop-color="#050506"/><stop offset=".85" stop-color="#26272E"/><stop offset="1" stop-color="#0A0A0C"/></linearGradient>
              <linearGradient id="b2chip" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2C2D35"/><stop offset=".45" stop-color="#0F1014"/><stop offset="1" stop-color="#050506"/></linearGradient>
              <clipPath id="b2scr"><ellipse cx="420" cy="208" rx="47" ry="37"/></clipPath>
              <radialGradient id="b2glass" cx="40%" cy="30%" r="85%"><stop offset="0" stop-color="#4F7FE0"/><stop offset=".5" stop-color="#1B3E92"/><stop offset="1" stop-color="#0A1640"/></radialGradient>
              <radialGradient id="b2rivet" cx="35%" cy="30%" r="80%"><stop offset="0" stop-color="#FFFFFF"/><stop offset=".5" stop-color="#A9AEB6"/><stop offset="1" stop-color="#555A62"/></radialGradient>
              <pattern id="b2grid" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(29)"><path d="M9 0H0V9" fill="none" stroke="rgba(170,205,255,.5)" stroke-width=".7"/></pattern>
              <linearGradient id="b2scan" x1="0" x2="1"><stop offset="0" stop-color="#9EC2FF" stop-opacity="0"/><stop offset="1" stop-color="#9EC2FF" stop-opacity=".45"/></linearGradient>
              <linearGradient id="b2steel" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F4F5F7"/><stop offset=".22" stop-color="#A3A8B0"/><stop offset=".46" stop-color="#E6E8EC"/><stop offset=".7" stop-color="#868B93"/><stop offset="1" stop-color="#D9DCE1"/></linearGradient>
              <linearGradient id="b2steelrim" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFFFFF"/><stop offset=".5" stop-color="#7A7F87"/><stop offset="1" stop-color="#F0F1F4"/></linearGradient>
              <radialGradient id="b2disc" cx="38%" cy="30%" r="85%"><stop offset="0" stop-color="#FAFBFC"/><stop offset=".6" stop-color="#D5D8DD"/><stop offset="1" stop-color="#B2B7BF"/></radialGradient>
              <linearGradient id="b2hl" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".55"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
            </defs>
            <g class="b2-lines"><path d="M228,48 C300,48 327.9,184 373.9,184" pathLength="100"/><path d="M228,114 C300,114 327.4,194 373.4,194" pathLength="100"/><path d="M228,180 C300,180 329.9,204 375.9,204" pathLength="100"/><path d="M228,246 C300,246 334.9,214 380.9,214" pathLength="100"/><path d="M228,312 C300,312 340.1,224 386.1,224" pathLength="100"/><path d="M228,378 C300,378 346.7,234 392.7,234" pathLength="100"/></g>
            <g class="b2-fibers"><path d="M228,109 C300,109 327.4,194 373.4,194" pathLength="100" class="fib f0" style="--i:1"/><path d="M228,241 C300,241 334.9,214 380.9,214" pathLength="100" class="fib f0" style="--i:3"/><path d="M228,373 C300,373 346.7,234 392.7,234" pathLength="100" class="fib f0" style="--i:5"/></g>
            <g class="b2-bigp" filter="url(#b2glow)"><path d="M228,48 C300,48 327.9,184 373.9,184" pathLength="100" class="bigp" style="--i:0"/><path d="M228,114 C300,114 327.4,194 373.4,194" pathLength="100" class="bigp" style="--i:1"/><path d="M228,180 C300,180 329.9,204 375.9,204" pathLength="100" class="bigp" style="--i:2"/><path d="M228,246 C300,246 334.9,214 380.9,214" pathLength="100" class="bigp" style="--i:3"/><path d="M228,312 C300,312 340.1,224 386.1,224" pathLength="100" class="bigp" style="--i:4"/><path d="M228,378 C300,378 346.7,234 392.7,234" pathLength="100" class="bigp" style="--i:5"/></g>
            <g class="b2-dots"><path d="M228,48 C300,48 327.9,184 373.9,184" pathLength="100" style="--i:0"/><path d="M228,180 C300,180 329.9,204 375.9,204" pathLength="100" style="--i:2"/><path d="M228,312 C300,312 340.1,224 386.1,224" pathLength="100" style="--i:4"/></g>
            <g class="b2-nodes"><g><rect x="20" y="26" width="208" height="44" rx="3"/><circle cx="42" cy="48" r="4" fill="#F6C98A"/><text x="60" y="53">Off-market</text></g><g><rect x="20" y="92" width="208" height="44" rx="3"/><circle cx="42" cy="114" r="4" fill="#9FB3D1"/><text x="60" y="119">MLS</text></g><g><rect x="20" y="158" width="208" height="44" rx="3"/><circle cx="42" cy="180" r="4" fill="#D5D8DD"/><text x="60" y="185">Public records</text></g><g><rect x="20" y="224" width="208" height="44" rx="3"/><circle cx="42" cy="246" r="4" fill="#E3B988"/><text x="60" y="251">New development</text></g><g><rect x="20" y="290" width="208" height="44" rx="3"/><circle cx="42" cy="312" r="4" fill="#8FA7D6"/><text x="60" y="317">Pre-development</text></g><g><rect x="20" y="356" width="208" height="44" rx="3"/><circle cx="42" cy="378" r="4" fill="#F2DFB0"/><text x="60" y="383">Cash discount</text></g></g>
            <g class="b2-ports"><g class="port" style="--i:0"><circle cx="374.9" cy="184" r="6.5" class="pg"/><circle cx="374.9" cy="184" r="3" class="pc"/></g><g class="port" style="--i:1"><circle cx="374.4" cy="194" r="6.5" class="pg"/><circle cx="374.4" cy="194" r="3" class="pc"/></g><g class="port" style="--i:2"><circle cx="376.9" cy="204" r="6.5" class="pg"/><circle cx="376.9" cy="204" r="3" class="pc"/></g><g class="port" style="--i:3"><circle cx="381.9" cy="214" r="6.5" class="pg"/><circle cx="381.9" cy="214" r="3" class="pc"/></g><g class="port" style="--i:4"><circle cx="387.1" cy="224" r="6.5" class="pg"/><circle cx="387.1" cy="224" r="3" class="pc"/></g><g class="port" style="--i:5"><circle cx="393.7" cy="234" r="6.5" class="pg"/><circle cx="393.7" cy="234" r="3" class="pc"/></g></g>
            <g class="b2-chip">
              <image href="/images/manhattan-mapping-icon.png" x="373.5" y="163.6" width="93.0" height="98.9"/>
              <mask id="b2scrmask" maskUnits="userSpaceOnUse" x="373.5" y="163.6" width="93.0" height="98.9"><image href="/images/manhattan-mapping-screen.png" x="373.5" y="163.6" width="93.0" height="98.9"/></mask>
              <g mask="url(#b2scrmask)" class="blue">
                <rect x="373.5" y="163.6" width="93.0" height="98.9" class="pulse"/>
                <rect x="373.5" y="163.6" width="93.0" height="98.9" fill="url(#b2grid)" class="gridfx"/>
                <rect x="373.5" y="163.6" width="32" height="98.9" fill="url(#b2scan)" class="sweep"/>
                <circle cx="398.5" cy="190.8" r="1.5" class="node" style="--i:0"/><circle cx="416.6" cy="190.8" r="1.5" class="node" style="--i:1"/><circle cx="405.3" cy="197.6" r="1.5" class="node" style="--i:2"/><circle cx="415.5" cy="202.1" r="1.5" class="node" style="--i:3"/>
              </g>
              <g class="emblem" transform="rotate(28 444.3 235.7)">
                <circle cx="444.3" cy="235.7" r="10.7" fill="url(#b2disc)" stroke="#9AA0A8" stroke-width="0.5"/>
                <text x="444.3" y="240.3" text-anchor="middle" class="q">Q</text>
              </g>
              <text x="420" y="282" text-anchor="middle" class="lbl">Match engine</text>
            </g>
            <g class="b2-out"><path d="M443.2,193 H616" class="o-glow" style="--i:0"/><path d="M452.0,213 H616" class="o-glow" style="--i:1"/><path d="M463.8,233 H616" class="o-glow" style="--i:2"/><path d="M443.2,193 H616" class="o-base"/><path d="M452.0,213 H616" class="o-base"/><path d="M463.8,233 H616" class="o-base"/><path d="M443.2,193 H616" pathLength="100" class="o-pulse" style="--i:0"/><path d="M452.0,213 H616" pathLength="100" class="o-pulse" style="--i:1"/><path d="M463.8,233 H616" pathLength="100" class="o-pulse" style="--i:2"/><circle cx="616" cy="193" r="5" class="o-sock" style="--i:0"/><circle cx="616" cy="213" r="5" class="o-sock" style="--i:1"/><circle cx="616" cy="233" r="5" class="o-sock" style="--i:2"/></g>
            <g class="b2-rep" transform="translate(-24,0)">
              <rect x="664" y="62" width="300" height="346" rx="3" class="pg pg3"/>
              <rect x="652" y="51" width="300" height="346" rx="3" class="pg pg2"/>
              <rect x="640" y="40" width="300" height="346" rx="3" class="card"/>
              <text x="662" y="72" class="sm">YOUR REPORT</text>
              <text x="662" y="122" class="big">92%</text>
              <text x="778" y="102" class="mid">Best fit</text><text x="778" y="122" class="sm2">Stretch · West Village</text>
              <rect x="662" y="146" width="256" height="1" class="rule"/>
              <g class="tiers">
                <text x="662" y="176" class="sm">ENTRY</text><rect x="730" y="168" width="188" height="8" rx="2" class="trk"/><rect x="730" y="168" width="120" height="8" rx="2" class="fill" style="--i:0"/>
                <text x="662" y="208" class="sm">CORE</text><rect x="730" y="200" width="188" height="8" rx="2" class="trk"/><rect x="730" y="200" width="146" height="8" rx="2" class="fill" style="--i:1"/>
                <text x="662" y="240" class="sm">STRETCH</text><rect x="730" y="232" width="188" height="8" rx="2" class="trk"/><rect x="730" y="232" width="176" height="8" rx="2" class="fill hot" style="--i:2"/>
                <text x="662" y="272" class="sm">CEILING</text><rect x="730" y="264" width="188" height="8" rx="2" class="trk"/><rect x="730" y="264" width="132" height="8" rx="2" class="fill" style="--i:3"/>
              </g>
              <rect x="662" y="292" width="256" height="1" class="rule"/>
              <text x="662" y="316" class="sm">3 MONTH OUTLOOK</text>
              <rect x="662" y="352" width="16" height="22" class="bar" style="--i:0"/><rect x="686" y="340" width="16" height="34" class="bar" style="--i:1"/><rect x="710" y="328" width="16" height="46" class="bar hot" style="--i:2"/>
              <text x="744" y="348" class="sm2">Dec</text><text x="744" y="362" class="sm2">Jan</text><text x="744" y="376" class="sm2">Feb</text>
            </g>
          </svg>
        </div>
        <ol class="b2-steps">
          <li data-reveal><b>1</b><h3>We read everything together</h3><p>Off-market, MLS, public records, new development, pre-development and cash discounts land in one place, not six tabs.</p></li>
          <li data-reveal style="--d:80ms"><b>2</b><h3>We match it to you</h3><p>Your neighborhood, bedrooms, budget and lifestyle goals set what counts as a fit.</p></li>
          <li data-reveal style="--d:160ms"><b>3</b><h3>We project three months out</h3><p>Which homes are likely to open, and when, at each price point.</p></li>
          <li data-reveal style="--d:240ms"><b>4</b><h3>You get the report</h3><p>A best fit, the array behind it, and the reasons for every ranking.</p></li>
        </ol>
      </div>
    </section>

    <section class="rv-sec b2-vs" aria-labelledby="b2-v">
      <div class="rv-wrap">
        <div class="rv-head">
          <p class="rv-eyebrow" data-reveal>The full report</p>
          <h2 class="rv-h2" id="b2-v" data-reveal>What lands in your hands.</h2>
          <p class="rv-lede" data-reveal>The sample shows the shape. The full report is a decision-ready dossier, prepared for you and built from six parts.</p>
        </div>
        <ValueStack />
      </div>
    </section>

    <section class="rv-sec b2-prom" aria-labelledby="b2-p">
      <div class="rv-wrap">
        <div class="rv-head">
          <p class="rv-eyebrow" data-reveal>Our promises</p>
          <h2 class="rv-h2" id="b2-p" data-reveal>What you can hold us to.</h2>
        </div>
        <Promises />
      </div>
    </section>

    <section class="rv-sec b2-quiz" id="quiz" aria-labelledby="b2-q">
      <div class="rv-wrap">
        <div class="rv-head">
          <p class="rv-eyebrow" data-reveal>Your turn</p>
          <h2 class="rv-h2" id="b2-q" data-reveal>Tell us how you want to live.</h2>
          <p class="rv-lede" data-reveal>Choose up to three life goals. We tell you the answer: where to start, how many bedrooms, and what to expect.</p>
        </div>
        <ReportQuiz mode="submit" />
      </div>
    </section>

    <section class="rv-sec b2-ps">
      <div class="rv-wrap">
        <div class="rv-ps" data-reveal>
          <b>P.S.</b>
          <div>
            <p>The report above is a sample. The price points, scores and outlook are illustrative, so you can see the shape of the real thing.</p>
            <p>Your full report names real homes, with their sources, their dates and the building research behind each. <a class="b2-link" href="/contact?intent=property">Request it here</a>, or <a class="b2-link" href="/building-reports/individual-buildings">browse the building profiles</a> first.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { initReveal, initCounters, initSpotlight, initScanRun, initQuiz } from "../scripts/rapid";
  initReveal(); initCounters(); initSpotlight(); initScanRun(); initQuiz("submit");
</script>

<style is:global>
  .b2-hero { padding-block: clamp(48px, 7vw, 96px) clamp(36px, 5vw, 64px); background: radial-gradient(900px 420px at 85% 0%, rgba(176, 141, 87, 0.14), transparent 70%); }
  .b2-hero-g { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .b2-hero-t { display: grid; gap: 22px; }
  .b2-cta { display: grid; gap: 14px; justify-items: start; }
  .b2-stats { padding-block: clamp(8px, 2vw, 24px); }

  .b2-letter { background: var(--bg2); }
  .b2-letter-c { max-width: 680px; margin: 0 auto; display: grid; gap: 22px; }
  .b2-prose { display: grid; gap: 18px; }
  .b2-prose p { margin: 0; font: 400 clamp(19px, 1.9vw, 22px)/1.65 var(--serif); color: var(--body); }
  .b2-prose p:first-child { font-style: italic; color: var(--mute); }
  .b2-prose p:nth-child(2)::first-letter { font: 500 4.2em/0.8 var(--serif); float: left; padding: 6px 12px 0 0; color: var(--acc); }
  .b2-prose strong { font-weight: 600; background: linear-gradient(transparent 62%, rgba(176, 141, 87, 0.34) 62%); }
