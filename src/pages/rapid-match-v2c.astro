---
import Base from "../layouts/Base.astro";
import StatsBand from "../components/rapid/StatsBand.astro";
import ScanRun from "../components/rapid/ScanRun.astro";
import Promises from "../components/rapid/Promises.astro";
import ValueStack from "../components/rapid/ValueStack.astro";
import ReportQuiz from "../components/rapid/ReportQuiz.astro";
import { buildingLibrary } from "../data/buildingLibrary";
import { lifeGoals } from "../data/rapidListings";
import "../styles/rapid-v2.css";

// Draft copy in a direct-response voice, for review.
const names = buildingLibrary.map((b) => b.name);
const laneA = [...names.slice(0, 34), ...names.slice(0, 34)];
const laneB = [...names.slice(34, 68), ...names.slice(34, 68)];
const laneC = [...names.slice(66), ...names.slice(66)];
---
<Base title="Rapid Match v2C | Agent Kammer" description="Stop scrolling four hundred listings. Answer four questions and start with the Manhattan home we would show you first.">
  <div class="rv rv-dark c2">

    <section class="c2-hero">
      <div class="c2-aurora" aria-hidden="true"><i></i><i></i></div>
      <div class="rv-wrap c2-hero-in">
        <p class="c2-chip" data-reveal><span class="rv-pulse"></span>Free sample · one minute</p>
        <h1 class="rv-h1" data-reveal style="--d:80ms">Tell us how you want to live. We'll tell you <span class="c2-grad">where to look.</span></h1>
        <p class="rv-lede" data-reveal style="--d:160ms">No questionnaire. Rapid Match starts from your life goals, reads off-market sources, the MLS, public records, new development, pre-development and cash discounts together, and tells you the answer: a ranked report across four price points, projected three months out.</p>
        <div class="c2-cta" data-reveal style="--d:240ms">
          <a class="rv-btn" href="#quiz">Choose my life goals <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
          <a class="rv-btn ghost" href="#story">See how it works</a>
        </div>
        <p class="rv-micro" data-reveal style="--d:300ms">Free. No card. We never call unless you ask.</p>
      </div>
      <div class="c2-lanes" aria-label="The building reference library, in motion" data-reveal style="--d:200ms">
        <div class="c2-lane"><div class="c2-run" style="--t:110s">{laneA.map((n) => <span>{n}</span>)}</div></div>
        <div class="c2-lane rev"><div class="c2-run" style="--t:130s">{laneB.map((n) => <span>{n}</span>)}</div></div>
        <div class="c2-lane"><div class="c2-run" style="--t:100s">{laneC.map((n) => <span>{n}</span>)}</div></div>
        <p class="c2-lanes-cap">{buildingLibrary.length} buildings in our reference library, across 10 neighborhoods.</p>
      </div>
    </section>

    <section class="rv-sec c2-run-sec" aria-labelledby="c2-r">
      <div class="rv-wrap c2-run-g">
        <div class="c2-run-t">
          <p class="rv-eyebrow" data-reveal>The run</p>
          <h2 class="rv-h2" id="c2-r" data-reveal>Every report starts with a read of the whole library.</h2>
          <p class="rv-lede" data-reveal>Before it ranks a single home, Rapid Match reads the buildings we have studied, then the six feeds, then you. Watch a run.</p>
        </div>
        <div data-reveal style="--d:120ms"><ScanRun /></div>
      </div>
      <div class="rv-wrap c2-stats"><StatsBand /></div>
    </section>

    <section class="rv-sec c2-words" aria-label="Why Rapid Match exists">
      <div class="rv-wrap">
        <p class="rv-eyebrow">Here's the problem</p>
        <p class="c2-big" data-words>By the time a home reaches your tabs, a small circle of people has often seen it already. Some of the best homes in Manhattan change hands without ever being listed. So we stopped asking what is for sale, and started asking what is likely to be open to you, at which price, over the next three months, for the life you actually want.</p>
      </div>
    </section>

    <section class="c2-story" id="story" data-story aria-labelledby="c2-s">
      <div class="rv-wrap">
        <div class="rv-head">
          <p class="rv-eyebrow" data-reveal>How it works</p>
          <h2 class="rv-h2" id="c2-s" data-reveal>From four answers to one clear report.</h2>
        </div>
        <div class="c2-story-g">
          <ol class="c2-chaps">
            <li data-chap="0"><b>01</b><h3>Every feed, read together</h3><p>Off-market, MLS, public records, new development, pre-development and cash discounts land in one place, not six tabs. Nothing is judged until all six are in.</p></li>
            <li data-chap="1"><b>02</b><h3>Starts from your life goals</h3><p>You tell us how you want to live. We turn your goals into a place, a size and a price band, so you never fill in a form.</p></li>
            <li data-chap="2"><b>03</b><h3>Projected three months out</h3><p>For each price point, a month by month view of what is likely to open, so timing becomes a decision and not a guess.</p></li>
            <li data-chap="3"><b>04</b><h3>Delivered as a report</h3><p>A best fit at the top, the array behind it, and plain English for every ranking. Real homes, sources and dates in your full report.</p></li>
          </ol>
          <div class="c2-vis-wrap">
            <div class="c2-vis" aria-hidden="true">
              <div class="c2-pane" data-p="0">
                <span class="rq-k">Reading</span>
                <div class="c2-feed"><em>Off-market</em><i style="--w:86%"></i></div>
                <div class="c2-feed"><em>MLS</em><i style="--w:64%"></i></div>
                <div class="c2-feed"><em>Public records</em><i style="--w:92%"></i></div>
                <div class="c2-feed"><em>New development</em><i style="--w:58%"></i></div>
                <div class="c2-feed"><em>Pre-development</em><i style="--w:40%"></i></div>
                <div class="c2-feed"><em>Cash discount</em><i style="--w:52%"></i></div>
                <small>Six feeds, one picture.</small>
              </div>
              <div class="c2-pane" data-p="1">
                <span class="rq-k">Your goals</span>
                <div class="c2-goals">{lifeGoals.slice(0, 6).map((g, i) => <span style={`--i:${i}`}>{g.label}</span>)}</div>
                <small>Your list decides the order.</small>
              </div>
              <div class="c2-pane" data-p="2">
                <span class="rq-k">Outlook · next three months</span>
                <div class="c2-months"><span><i style="--h:42%"></i><em>Month 1</em></span><span><i style="--h:76%"></i><em>Month 2</em></span><span><i style="--h:60%"></i><em>Month 3</em></span></div>
                <small>Illustrative outlook.</small>
              </div>
              <div class="c2-pane" data-p="3">
                <span class="rq-k">Sample match report</span>
                <div class="c2-fit"><svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="50" class="t"/><circle cx="60" cy="60" r="50" class="f" pathLength="100"/></svg><b>92%</b></div>
                <div class="c2-tiers"><span>Entry</span><span>Core</span><span class="on">Stretch</span><span>Ceiling</span></div>
                <small>Best fit across four price points.</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rv-sec c2-vs" aria-labelledby="c2-v">
      <div class="rv-wrap">
        <div class="rv-head">
          <p class="rv-eyebrow" data-reveal>The full report</p>
          <h2 class="rv-h2" id="c2-v" data-reveal>What lands in your hands.</h2>
          <p class="rv-lede" data-reveal>The sample shows the shape. The full report is a decision-ready dossier, prepared for you and built from six parts.</p>
        </div>
        <ValueStack />
      </div>
    </section>

    <section class="rv-sec c2-prom" aria-labelledby="c2-p">
      <div class="rv-wrap">
        <div class="rv-head">
          <p class="rv-eyebrow" data-reveal>Our promises</p>
          <h2 class="rv-h2" id="c2-p" data-reveal>What you can hold us to.</h2>
        </div>
        <Promises />
      </div>
    </section>

    <section class="rv-sec c2-quiz" id="quiz" aria-labelledby="c2-q">
      <div class="rv-wrap">
        <div class="rv-head">
          <p class="rv-eyebrow" data-reveal>Your turn</p>
          <h2 class="rv-h2" id="c2-q" data-reveal>Tell us how you want to live.</h2>
          <p class="rv-lede" data-reveal>Choose up to three life goals and watch your answer take shape.</p>
        </div>
        <ReportQuiz mode="live" />
      </div>
    </section>

    <section class="rv-sec c2-ps">
      <div class="rv-wrap">
        <div class="rv-ps" data-reveal>
          <b>P.S.</b>
          <div>
            <p>This is a sample. The price points, scores and outlook are illustrative, so you can see the shape of the real thing.</p>
            <p>Your full report names real homes, with their sources, dates and the building research behind each. <a class="c2-link" href="/contact?intent=property">Request it here</a>, or <a class="c2-link" href="/building-reports/individual-buildings">browse the building profiles</a> first.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { initReveal, initCounters, initSpotlight, initScanRun, initStory, initWords, initQuiz } from "../scripts/rapid";
  initReveal(); initCounters(); initSpotlight(); initScanRun(); initStory(); initWords(); initQuiz("live");
</script>

<style is:global>
  .c2 { background: #070E24; }
  .c2-hero { position: relative; overflow: hidden; padding-block: clamp(56px, 8vw, 112px) clamp(32px, 5vw, 56px); background: radial-gradient(1000px 520px at 50% -10%, #17306A 0%, rgba(7, 14, 36, 0) 70%), #070E24; }
  .c2-aurora { position: absolute; inset: 0; pointer-events: none; }
  .c2-aurora i { position: absolute; width: 60vw; height: 60vw; max-width: 780px; max-height: 780px; border-radius: 50%; filter: blur(90px); opacity: 0.4; }
  .c2-aurora i:first-child { left: -12%; top: -30%; background: #2a3f78; animation: c2-drift 22s ease-in-out infinite alternate; }
  .c2-aurora i:last-child { right: -14%; top: 8%; background: rgba(246, 201, 138, 0.28); animation: c2-drift 28s ease-in-out infinite alternate-reverse; }
  @keyframes c2-drift { to { transform: translate(8%, 10%) scale(1.12); } }
  .c2-hero-in { position: relative; display: grid; gap: 22px; justify-items: center; text-align: center; }
  .c2-hero-in .rv-h1 { max-width: 16ch; }
  .c2-hero-in .rv-lede { max-width: 60ch; }
  .c2-chip { display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--card); font: 600 11px/1 var(--sans); letter-spacing: 0.18em; text-transform: uppercase; color: var(--mute); }
  .c2-grad { background: linear-gradient(100deg, #F6C98A, #F5F2EB 55%, #9FB3D1); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .c2-cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .c2-lanes { position: relative; margin-top: clamp(40px, 6vw, 72px); display: grid; gap: 10px; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .c2-lane { overflow: hidden; }
  .c2-run { display: flex; gap: 10px; width: max-content; animation: c2-slide var(--t, 100s) linear infinite; }
  .c2-lane.rev .c2-run { animation-direction: reverse; }
  .c2-run span { white-space: nowrap; padding: 10px 16px; border: 1px solid var(--line); background: var(--card); font: 500 13px/1 var(--sans); color: var(--body); }
  @keyframes c2-slide { to { transform: translateX(-50%); } }
  .c2-lanes-cap { margin: 14px 0 0; text-align: center; font: 500 12px/1 var(--sans); letter-spacing: 0.1em; color: var(--mute); }

  .c2-run-g { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .c2-run-t { display: grid; gap: 18px; }
  .c2-stats { margin-top: clamp(40px, 6vw, 80px); }

  .c2-words { padding-block: clamp(40px, 6vw, 80px); }
  .c2-words .rv-wrap { display: grid; gap: 24px; max-width: 960px; }
  .c2-big { margin: 0; font: 500 clamp(28px, 4.2vw, 52px)/1.22 var(--serif); letter-spacing: -0.01em; }
  .c2-big .w { color: rgba(245, 242, 235, 0.22); transition: color 0.4s; }
  .c2-big .w.on { color: #F5F2EB; }

  .c2-story { padding-block: clamp(56px, 8vw, 104px); background: linear-gradient(180deg, #070E24, #0B1A44 40%, #070E24); }
  .c2-story-g { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .c2-chaps { list-style: none; margin: 0; padding: 0; }
  .c2-chaps li { display: grid; gap: 10px; align-content: center; min-height: min(62vh, 520px); padding-block: 24px; opacity: 0.35; transition: opacity 0.5s; border-top: 1px solid var(--line); }
  .c2-chaps li:first-child { border-top: 0; }
  [data-step="0"] .c2-chaps li[data-chap="0"], [data-step="1"] .c2-chaps li[data-chap="1"], [data-step="2"] .c2-chaps li[data-chap="2"], [data-step="3"] .c2-chaps li[data-chap="3"] { opacity: 1; }
  .c2-chaps b { font: 600 11px/1 var(--sans); letter-spacing: 0.2em; color: var(--acc); }
  .c2-chaps h3 { font-size: clamp(30px, 3.4vw, 44px); line-height: 1.06; }
  .c2-chaps p { margin: 0; max-width: 44ch; font-size: 16px; line-height: 1.7; color: var(--body); }
  .c2-vis-wrap { position: sticky; top: 14vh; }
  .c2-vis { position: relative; min-height: 380px; aspect-ratio: 1 / 0.9; background: radial-gradient(circle at 18% 0%, #2a3f78 0%, #17306A 38%, #0B1A44 100%); border: 1px solid rgba(160, 185, 235, 0.3); border-top: 2px solid var(--acc); box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8); overflow: hidden; }
  .c2-pane { position: absolute; inset: 0; display: grid; gap: 14px; align-content: center; padding: clamp(20px, 3vw, 40px); opacity: 0; transform: translateY(14px); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); pointer-events: none; }
  [data-step="0"] .c2-pane[data-p="0"], [data-step="1"] .c2-pane[data-p="1"], [data-step="2"] .c2-pane[data-p="2"], [data-step="3"] .c2-pane[data-p="3"] { opacity: 1; transform: none; }
  .c2-pane small { font-size: 13px; color: var(--mute); }
  .c2-feed { display: grid; gap: 8px; }
  .c2-feed em { font: 600 11px/1 var(--sans); font-style: normal; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fg); }
  .c2-feed i { display: block; height: 8px; background: rgba(245, 242, 235, 0.1); position: relative; overflow: hidden; }
  .c2-feed i::after { content: ""; position: absolute; inset: 0; width: 0; background: linear-gradient(90deg, #7B8590, #F6C98A); }
  [data-step="0"] .c2-feed i::after { width: var(--w); transition: width 1.6s var(--ease) 0.2s; }
  .c2-goals { display: flex; flex-wrap: wrap; gap: 10px; }
  .c2-goals span { padding: 12px 16px; border: 1px solid var(--line); font: 500 14px/1 var(--sans); color: var(--fg); }
  [data-step="1"] .c2-goals span { animation: c2-goal 6s ease-in-out infinite; animation-delay: calc(var(--i) * 0.7s); }
  @keyframes c2-goal { 0%, 22%, 100% { background: transparent; color: #F5F2EB; border-color: rgba(160, 185, 235, 0.22); } 6%, 16% { background: #F5F2EB; color: #2A3447; border-color: #F6C98A; } }
  .c2-months { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; height: 180px; align-items: end; }
  .c2-months span { display: grid; gap: 10px; align-content: end; height: 100%; }
  .c2-months i { display: block; height: 0; background: linear-gradient(180deg, rgba(246, 201, 138, 0.55), rgba(246, 201, 138, 0.1)); border-top: 2px solid #F6C98A; }
  [data-step="2"] .c2-months i { height: var(--h); transition: height 1.1s var(--ease) 0.2s; }
  .c2-months em { font: 600 10px/1 var(--sans); font-style: normal; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mute); text-align: center; }
  .c2-fit { position: relative; width: 150px; height: 150px; }
  .c2-fit svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .c2-fit circle { fill: none; stroke-width: 7; }
  .c2-fit .t { stroke: rgba(245, 242, 235, 0.12); }
  .c2-fit .f { stroke: #F6C98A; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; }
  [data-step="3"] .c2-fit .f { stroke-dashoffset: 8; transition: stroke-dashoffset 1.5s var(--ease) 0.2s; }
  .c2-fit b { position: absolute; inset: 0; display: grid; place-items: center; font: 500 44px/1 var(--serif); }
  .c2-tiers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .c2-tiers span { padding: 10px 6px; border: 1px solid var(--line); text-align: center; font: 600 10.5px/1 var(--sans); letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); }
  .c2-tiers span.on { background: #F5F2EB; color: #2A3447; border-color: #F6C98A; }

  .c2-quiz { background: #0B1A44; }
  .c2-quiz .rq-out { background: rgba(7, 14, 36, 0.5); }
  .c2-link { color: var(--fg); text-decoration: underline; text-decoration-color: var(--acc); text-underline-offset: 4px; }
  .c2-ps { padding-block: clamp(32px, 5vw, 64px) clamp(56px, 8vw, 96px); }

  @media (max-width: 900px) {
    .c2-run-g, .c2-story-g { grid-template-columns: minmax(0, 1fr); }
    .c2-vis-wrap { position: sticky; top: 72px; order: -1; z-index: 2; }
    .c2-vis { min-height: 0; aspect-ratio: auto; height: 300px; }
    .c2-chaps li { min-height: min(52vh, 420px); }
  }
</style>
