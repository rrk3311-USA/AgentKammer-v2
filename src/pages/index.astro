---
import Base from "../layouts/Base.astro";
import { whatsChangingGroups } from "../data/nav";

const pillars = [
  { icon: "clarity", title: "Clarity", text: "We cut through noise to identify what truly matters" },
  { icon: "intelligence", title: "Intelligence", text: "Deep market knowledge and insight beyond the listings" },
  { icon: "strategy", title: "Strategy", text: "Every move is intentional. Every detail considered" },
  { icon: "discretion", title: "Discretion", text: "Your goals are personal. Your process should be too" },
];

const howWeDecide = [
  { n: "01", title: "What’s changing?", text: "Name the life event, pressure, or uncertainty. Neighborhoods and inventory come later." },
  { n: "02", title: "Should anything change?", text: "Sometimes the highest-value recommendation is to do nothing." },
  { n: "03", title: "Where do you belong?", text: "Even if you stay, is the environment still serving the life you want?" },
];
---
<Base
  title="Agent Kammer | Private Housing Advisory"
  description="Private housing guidance before the market gets loud. Stay, renovate, rent, buy, sell, or wait."
>
  <link slot="head" rel="preload" as="image" href="/images/hero-liberty.jpg" fetchpriority="high" />

  <section class="hero">
    <div class="ph" role="img" aria-label="Statue of Liberty torch and crown against a navy sky"></div>
    <div class="wrap">
      <div class="in">
        <h1>Live where<br />you <em>belong</em></h1>
        <p class="lede">Private housing guidance before the market gets loud.</p>
        <p class="sub">People do not wake up wanting to tour apartments. They wake up because life changed.</p>
        <a class="btn" href="#start">What’s changing <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
      </div>
    </div>
  </section>

  <section class="pillars" aria-labelledby="pt">
    <div class="wrap">
      <h2 id="pt">Strategy over transactions</h2>
      <ul>
        {pillars.map((p) => (
          <li>
            <span class="pi" aria-hidden="true" style={`--m:url(/icons/${p.icon}.svg)`}></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="photo">
    <img src="/images/band-harbor.webp" width="1200" height="800" alt="" loading="lazy" decoding="async" />
  </div>

  <div class="hw">
    <div class="wrap">
      <div class="eyebrow">How we decide</div>
      <h2>Three questions. Then judgment.</h2>
      <div class="hw-list">
        {howWeDecide.map((s) => (
          <div class={s.n === "01" ? "hw-step mid" : "hw-step"} id={s.n === "01" ? "start" : undefined}>
            <span class="n">{s.n}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              {s.n === "01" && (
                <>
                  <div class="og" aria-label="Start from what changed">
                    {whatsChangingGroups.map((g) => (
                      <details name="og">
                        <summary><span class="t">{g.title}</span><span class="open" aria-hidden="true"></span></summary>
                        <ul>
                          {g.items.map((c) => (
                            <li><a href={c.href}>{c.label}<svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a></li>
                          ))}
                        </ul>
                      </details>
                    ))}
                  </div>
                </>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="below">
    <div class="wrap diag">
      <div>
        <h2>Not sure where to start? Tell us what changed.</h2>
        <p>Receive a Situation Assessment: share what changed, and we send back a personal profile of where you stand.</p>
      </div>
      <a class="btn" href="/contact">Request a Situation Assessment <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
    </div>
  </div>
</Base>
