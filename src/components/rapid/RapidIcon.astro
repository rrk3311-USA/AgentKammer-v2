---
// A small set of line icons, one stroke weight, so the v2 pages read as one system.
interface Props { name: string; size?: number }
const { name, size = 22 } = Astro.props;
const paths: Record<string, string> = {
  feeds: '<path d="M4 7h9M4 12h16M4 17h9"/><circle cx="17" cy="7" r="2"/><circle cx="17" cy="17" r="2"/>',
  sliders: '<path d="M4 7h5m6 0h5M4 12h9m6 0h1M4 17h3m6 0h7"/><circle cx="12" cy="7" r="2"/><circle cx="16" cy="12" r="2"/><circle cx="10" cy="17" r="2"/>',
  calendar: '<rect x="4" y="5" width="16" height="15" rx="1"/><path d="M4 10h16M9 3v4m6-4v4"/>',
  building: '<path d="M5 21V4l9-1.5V21M14 8h5v13M8.5 8h2m-2 4h2m-2 4h2m6-5h.5m-.5 4h.5M3 21h18"/>',
  doc: '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 12h5m-5 4h5"/>',
  layers: '<path d="M12 4l8 4-8 4-8-4z"/><path d="M4 12l8 4 8-4M4 16l8 4 8-4"/>',
  compass: '<circle cx="12" cy="12" r="8"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>',
  shield: '<path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  clock: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>',
  eye: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
};
---
<svg class="rv-ic" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={paths[name]} />
