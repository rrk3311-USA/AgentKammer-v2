---
// The guide. One scrolling thread with tap-to-answer choices, no side stage and no page frames.
// The opening triage is scripted so it never fails. Free-text questions go to /api/chat and fall
// back to a short answer or a handoff to a person. A request for an assessment posts to /api/contact.
---
<script is:inline>
(function(){
if(window.top!==window||document.getElementById('ak-guide'))return;
var BASE='/',ENDPOINT='/api/contact';
var RM=window.matchMedia&&matchMedia('(prefers-reduced-motion:reduce)').matches;
var wait=function(ms){return new Promise(function(r){setTimeout(r,RM?0:ms)})};
var root=document.createElement('aside');root.id='ak-guide';root.setAttribute('aria-label','Guide');
root.innerHTML='<button type="button" class="lc" id="akl" aria-expanded="false" aria-controls="akp"><span class="dt"></span><b>Live guide</b><span class="av"><img src="'+BASE+'images/guide-avatar.webp" alt="" width="60" height="60"></span></button>'+
'<div class="pn" id="akp" role="dialog" aria-label="Your Manhattan Guide" hidden><div class="hd"><span>Agent Kammer</span><button type="button" id="akc">Minimize</button></div>'+
'<div class="who"><span class="pic"><img src="'+BASE+'images/guide-avatar.webp" alt="" width="60" height="60"></span><div><strong>Your Manhattan Guide</strong><small><i></i>Online now</small></div></div>'+
'<div class="pg"><div class="tr"><span id="akf"></span></div><p id="aks">Starting the conversation</p></div>'+
'<div class="lg" id="akg" role="log" aria-live="polite"></div>'+
'<form class="fm" id="akm"><label class="sr" for="aki" style="position:absolute;left:-9999px">Your message</label><input id="aki" type="text" maxlength="400" placeholder="Ask me anything..." autocomplete="off" enterkeyhint="send"><button type="submit">Send</button></form>'+
'<p class="nt">AI guide. Our team reads chats you choose to save.</p></div>';
document.body.appendChild(root);
var $=function(i){return document.getElementById(i)},L=$('akl'),P=$('akp'),G=$('akg'),I=$('aki'),F=$('akf'),T=$('aks');
var hist=[],steps=['What changed','Where you stand','Your next step'],cur=-1,started=false,busy=false,ty=null,st={};
function step(n){if(n<=cur)return;cur=n;F.style.width=((n+1)/3*100)+'%';T.textContent='Step '+(n+1)+' of 3 · '+steps[n]}
function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}
function down(){G.scrollTop=G.scrollHeight}
function say(t,u){var m=el('p','m'+(u?' u':''),t);G.appendChild(m);down();if(t)hist.push({role:u?'user':'assistant',content:t});return m}
function typing(on){if(on&&!ty){ty=el('p','m ty');ty.setAttribute('aria-label','The guide is typing');ty.innerHTML='<i></i><i></i><i></i>';G.appendChild(ty);down()}else if(!on&&ty){ty.remove();ty=null}}
async function bot(lines){for(var i=0;i<lines.length;i++){typing(true);await wait(500+Math.min(lines[i].length*9,900));typing(false);var m=say(lines[i].t||lines[i]);if(lines[i].html){m.innerHTML=lines[i].html;hist[hist.length-1].content=m.textContent}await wait(220)}}
function opts(list,cb){var box=el('div','op');box.setAttribute('role','group');list.forEach(function(o){var b=el('button','',o);b.type='button';b.onclick=function(){if(box.classList.contains('done')||busy)return;box.classList.add('done');b.classList.add('on');setTimeout(function(){say(o,true);cb(o)},180)};box.appendChild(b)});G.appendChild(box);down()}
function hello(){var h=new Date().getHours();return h<12?'Good morning':h<18?'Good afternoon':'Good evening'}
var INS={
'New job or relocating to NYC':'Relocations tend to turn on one question: how soon you need to be settled. A lease buys you time to learn the city, while a well-chosen purchase can spare you moving twice. Neither is wrong. They simply suit different timelines.',
'Growing family':'With a growing family, square footage is rarely the whole story. It is how long the home will serve you, and what the building offers, such as storage, service and proximity to schools, so that you are not moving again in three years.',
'Selling or downsizing':'When a home grows smaller, the best outcome is usually a move that feels like a gain: less upkeep, a building with service, nothing left to manage. How you time the sale against the purchase matters more than most people expect.',
'Inheritance or new capital':'When capital arrives, the instinct is to act. The advisors I respect counsel the opposite. A property is a long holding, so the first move is deciding what it is for.',
'Marriage or divorce':'Two lives becoming one, or one becoming two, ask the same of a home: clarity about what is shared, and what each person needs the next place to do.'};
var AREA={
'I already have a neighborhood in mind':'Then you have done half the work. The other half is the building: its finances, its board, and how it is likely to treat you in ten years.',
'I am still getting a feel for the city':'Wise, and quite common. Manhattan is closer to a collection of villages than a single city. Tribeca prizes quiet and light, the Upper West Side the park and a daily routine, and the Financial District a short walk to the office.',
'I would rather start with the building':'A sound instinct. In New York the building often matters more than the apartment: its reserves, its management, its rules. A handsome unit in a poorly run building tends to disappoint.'};
var TIME={
'Within a few weeks':'Then we should be deliberate rather than hurried: a short list of buildings that truly fit, and the paperwork ready before you need it.',
'Over the next season':'A comfortable window, with time to see the city in its different moods and still act with confidence.',
'A year or more':'That is a luxury. It allows us to watch the market quietly and wait for the right building rather than the available one.',
'No fixed date':'Perfectly reasonable. The best decisions are seldom made against a clock.'};
async function start(){
 if(started)return;started=true;busy=true;
 await bot([hello()+', and welcome. I am your Manhattan guide.','Most people who find their way here are not shopping for an apartment. Something has shifted, and a home is part of the answer.',{t:'What is closest to where you find yourself?'}]);
 busy=false;step(0);ask1()}
function ask1(){opts(['New job or relocating to NYC','Growing family','Selling or downsizing','Inheritance or new capital','Marriage or divorce','Something else'],pick1)}
async function pick1(o){busy=true;st.situation=o;step(1);
 if(INS[o]){await bot([INS[o]])}else{await bot(['Then tell me in your own words, whenever you like. There is no wrong place to begin.']);busy=false;st.free=true;I.placeholder='Tell me what has changed...';I.focus({preventScroll:true});return}
 await bot(['May I ask how far along you are in thinking about where?']);busy=false;
 opts(Object.keys(AREA),pick2)}
async function pick2(o){busy=true;st.area=o;await bot([AREA[o],'And is there a horizon you have in mind?']);busy=false;opts(Object.keys(TIME),pick3)}
async function pick3(o){busy=true;st.time=o;step(2);
 await bot([TIME[o],'From what you have shared, I would suggest a Situation Assessment: a short, private profile of where you stand and what I would weigh first. There is no obligation, and a person writes it.']);busy=false;
 opts(['Yes, please prepare one','Not yet, I would like to keep talking','Show me a few guides'],pick4)}
async function pick4(o){busy=true;
 if(o.indexOf('Yes')===0){await bot(['Wonderful. Where may a person send it?']);busy=false;lead()}
 else if(o.indexOf('Not yet')===0){await bot(['Of course. Ask me anything, or tell me a little more about what has changed. I am in no hurry.']);busy=false;I.focus({preventScroll:true});opts(['What is a Situation Assessment?','Condo or co-op?'],function(q){reply(q)})}
 else{await bot([{t:'',html:'Three that readers value most: <a href="'+BASE+'guides/how-to-buy-in-nyc.html">How to buy in NYC</a>, <a href="'+BASE+'situations/condo-vs-coop.html">Condo vs Co-op</a>, and <a href="'+BASE+'guides/how-wealth-is-held.html">How wealth is held</a>. They open in this window; the conversation will be waiting.'}]);busy=false;opts(['Prepare my assessment instead','I will keep reading'],function(x){x.indexOf('Prepare')===0?pick4('Yes, please prepare one'):bot(['Very good. I will be here when you want me.'])})}}
function lead(){
 var f=el('form','lead');f.innerHTML='<input name="name" autocomplete="name" placeholder="Your name" required aria-label="Your name"><input name="email" type="email" autocomplete="email" placeholder="Email address" required aria-label="Email address"><button type="submit">Send my assessment request</button><small>Private. A person replies, and nothing is shared.</small>';
 f.onsubmit=async function(e){e.preventDefault();var b=f.querySelector('button');b.disabled=true;b.textContent='Sending';
  var d=new URLSearchParams({form:'Guide',name:f.name.value.trim(),email:f.email.value.trim(),changed:(st.situation||'Not stated')+(st.free&&st.text?': '+st.text:''),decision:'Situation Assessment',timeline:({'Within a few weeks':'Now / 30 days','Over the next season':'3-6 months','A year or more':'6+ months','No fixed date':'Just exploring'})[st.time]||'Just exploring',next:'Situation Assessment',more:[st.area&&('Where: '+st.area),st.time&&('Horizon: '+st.time),'Via the guide'].filter(Boolean).join('. ')});
  try{var r=await fetch(ENDPOINT,{method:'POST',headers:{'content-type':'application/x-www-form-urlencoded',accept:'application/json'},body:d});if(!r.ok&&r.type!=='opaqueredirect')throw 0;
   f.remove();await bot(['Thank you, '+f.name.value.trim().split(' ')[0]+'. Your request is with the team, and a person will write to you personally. In the meantime, I am here if you would like to keep talking.'])}
  catch(x){b.disabled=false;b.textContent='Send my assessment request';var s=f.querySelector('small');s.textContent='That did not go through just now. Please try once more in a moment, or write to us from the Contact page.'}};
 G.appendChild(f);down();f.name.focus({preventScroll:true})}
var QA=[[/co-?op|condo/i,'A condominium is owned outright, as real property. A co-op is a share in a corporation with a lease on your apartment, and the board approves each buyer. Condos tend to be more flexible and co-ops often more economical. The right one depends on how you intend to hold it.'],
[/board|approval/i,'Board approval is part of buying a co-op, and some condos have a right of first refusal. It is a review of finances and references, and good preparation makes it a formality far more often than not.'],
[/mortgage|financ|loan/i,'Financing in Manhattan has its own habits: co-ops often ask for more liquidity after closing than a lender would, and some buildings limit how much you may borrow. It is worth knowing a building’s rules before you fall for it.'],
[/assessment/i,'A Situation Assessment is a short, private profile: what changed, where you stand, and what I would weigh first. A person writes it, and it carries no obligation.'],
[/tribeca|upper west|upper east|chelsea|hudson yards|financial district|soho|village/i,'Each of those neighborhoods has a distinct rhythm, and the right one follows your daily life more than your budget. Tell me how you spend a typical week, and I will point you toward the one that fits.']];
async function ai(){
 var res=await fetch('/api/chat',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({messages:hist.slice(-12),page:location.pathname,context:Object.fromEntries(['situation','decision','building','area'].map(function(k){return [k,new URLSearchParams(location.search).get(k)||'']}).filter(function(x){return x[1]}))})});
 if(!res.ok)throw 0;var d=await res.json();if(!d.blocks||!d.blocks.length)throw 0;return d.blocks}
async function reply(t){if(busy)return;say(t,true);busy=true;st.text=st.text||t;
 if(st.free&&!st.area){st.free=false;I.placeholder='Ask me anything...';await bot(['Thank you for telling me. That is very helpful.','May I ask how far along you are in thinking about where?']);busy=false;opts(Object.keys(AREA),pick2);return}
 typing(true);var blocks=null;try{blocks=await ai()}catch(x){blocks=null}typing(false);
 if(blocks){var ch=null,lines=[];blocks.forEach(function(b){if(b.type==='text')lines.push(b.text);else if(b.type==='slide')lines.push([b.title].concat(b.points||[]).join('. ')+(b.takeaway?' '+b.takeaway:''));else if(b.type==='steps')lines.push('Next steps: '+b.items.join(' Then, '));else if(b.type==='choices'){lines.push(b.question);ch=b.options}});
  await bot(lines);busy=false;if(ch)opts(ch,function(x){reply(x)});return}
 var a=null;QA.some(function(q){if(q[0].test(t)){a=q[1];return true}});
 if(a){await bot([a]);busy=false;return}
 await bot(['That deserves a proper answer, and I would rather you had it from a person than a guess from me. If you leave your email, the team will reply personally.']);busy=false;
 opts(['Leave my email','Keep exploring'],function(x){x.indexOf('Leave')===0?lead():bot(['Of course. Ask whatever comes to mind.'])})}
function open(on){P.hidden=!on;L.hidden=on;L.setAttribute('aria-expanded',String(on));if(on){start();setTimeout(function(){I.focus({preventScroll:true})},50)}else L.focus()}
var sess=Math.random().toString(36).slice(2,10),sent=0;function sendT(){var n=hist.filter(function(h){return h.role==='user'}).length;if(!n||n===sent)return;sent=n;try{navigator.sendBeacon('/api/transcript',JSON.stringify({turns:hist,page:location.pathname,session:sess}))}catch(e){}}
document.addEventListener('visibilitychange',function(){if(document.visibilityState==='hidden')sendT()});addEventListener('pagehide',sendT);
L.onclick=function(){open(true)};$('akc').onclick=function(){open(false);sendT()};
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!P.hidden)open(false)});
$('akm').onsubmit=function(e){e.preventDefault();var t=I.value.trim();if(!t)return;I.value='';if(!started){start();return}reply(t)};
window.addEventListener('guide:ask',function(e){var t=String(e.detail||'').trim().slice(0,300);if(!t)return;if(!started){started=true;step(1);bot_hi()}open(true);reply(t)});
function bot_hi(){say(hello()+', and welcome. I am your Manhattan guide.')}
if(window.visualViewport){var vv=visualViewport,fit=function(){if(P.hidden)return;var k=Math.max(0,innerHeight-vv.height-vv.offsetTop);root.style.bottom=k>80?(k+8)+'px':'';P.style.height=k>80?Math.max(260,vv.height-16)+'px':'';down()};vv.addEventListener('resize',fit);vv.addEventListener('scroll',fit)}
document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a');if(a&&/^\s*live chat\s*$/i.test(a.textContent)){e.preventDefault();open(true)}});
})();

</script>

<style is:global>
#ak-guide,#ak-guide *{box-sizing:border-box}
#ak-guide{--ink:#f5f2eb;--soft:#c3cbe0;--dim:#8f9bbd;--champ:#d9b979;--navy:#14246a;--rule:rgba(160,185,235,.28);--card:rgba(255,255,255,.07);
position:fixed;right:max(16px,env(safe-area-inset-right,0px));bottom:max(16px,env(safe-area-inset-bottom,0px));z-index:60;font-family:Inter,system-ui,sans-serif;color:var(--ink)}
#ak-guide ::selection{background:#f5f2eb;color:#0f1d4c}
#ak-guide button{font:inherit;color:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}
#ak-guide .lc{position:relative;display:flex;align-items:center;gap:11px;height:42px;padding:0 50px 0 16px;border-radius:999px;border:1px solid rgba(245,242,235,.3);background:rgba(27,34,50,.86);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);box-shadow:0 10px 22px rgba(30,42,58,.28);color:var(--ink)}
#ak-guide .lc:hover{background:rgba(35,44,64,.92)}
#ak-guide .lc b{font:500 15px/1 "Cormorant Garamond",Georgia,serif;letter-spacing:.12em;text-transform:uppercase;border-left:1px solid rgba(245,242,235,.5);padding-left:12px;white-space:nowrap}
#ak-guide .lc .dt{width:9px;height:9px;border-radius:50%;background:#4fa86a;box-shadow:0 0 6px #4fa86a}
#ak-guide .lc .av{position:absolute;right:6px;top:50%;margin-top:-15px;width:30px;height:30px;border-radius:50%;overflow:hidden;background:linear-gradient(#e9e4d8,#cfc8b8);box-shadow:0 0 0 1px rgba(176,141,87,.7)}
#ak-guide .lc .av img{width:100%;height:100%;padding:12% 8% 0;object-fit:contain;object-position:50% 100%}
#ak-guide .pn{display:flex;flex-direction:column;width:min(390px,calc(100vw - 24px));height:min(680px,calc(100dvh - 32px));border-radius:18px;border:1px solid var(--rule);overflow:hidden;background:radial-gradient(circle at 15% 0,rgba(70,100,190,.55),transparent 55%),linear-gradient(165deg,#2b3d7b 0%,#1a2b6b 52%,#0e1b49 100%);box-shadow:0 24px 54px rgba(8,16,48,.5)}
#ak-guide [hidden]{display:none!important}
#ak-guide .hd{display:flex;justify-content:space-between;align-items:center;padding:16px 18px 0;flex:none}
#ak-guide .hd span{font:600 11px/1 Inter,sans-serif;letter-spacing:.24em;text-transform:uppercase}
#ak-guide .hd button{background:none;border:0;border-bottom:1px solid var(--soft);padding:4px 0;font:500 10px/1 Inter,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--soft)}
#ak-guide .hd button:hover{color:#fff;border-color:#fff}
#ak-guide .who{display:flex;align-items:center;gap:13px;padding:12px 18px 12px;flex:none}
#ak-guide .who .pic{flex:none;width:54px;height:54px;border-radius:50%;overflow:hidden;background:linear-gradient(#e9e4d8,#cfc8b8);box-shadow:0 0 0 1px rgba(217,185,121,.7)}
#ak-guide .who .pic img{width:100%;height:100%;padding:12% 8% 0;object-fit:contain;object-position:50% 100%}
#ak-guide .who strong{display:block;font:500 24px/1.1 "Cormorant Garamond",Georgia,serif}
#ak-guide .who small{display:flex;align-items:center;gap:7px;margin-top:5px;font-size:13px;color:var(--soft)}
#ak-guide .who small i{width:9px;height:9px;border-radius:50%;background:#4fa86a;animation:akb 2.6s ease-in-out infinite}
@keyframes akb{0%,100%{transform:scale(.85);box-shadow:0 0 0 0 rgba(79,168,106,.55)}50%{transform:scale(1.1);box-shadow:0 0 0 5px rgba(79,168,106,0)}}
#ak-guide .pg{padding:0 18px 10px;flex:none}
#ak-guide .tr{height:2px;background:var(--rule)}
#ak-guide .tr span{display:block;height:100%;width:0;background:var(--champ);transition:width .6s}
#ak-guide .pg p{margin:9px 0 0;font:500 10px/1.3 Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:var(--soft)}
#ak-guide .lg{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain;margin:0 12px;padding:12px;display:flex;flex-direction:column;gap:10px;scroll-behavior:smooth;border:1px solid var(--rule);border-radius:14px;background:rgba(255,255,255,.04)}
#ak-guide .lg>*{flex:none}
#ak-guide .m{margin:0;padding:14px 16px;border-radius:14px;border:1px solid var(--rule);background:var(--card);font:italic 400 18px/1.45 "Cormorant Garamond",Georgia,serif;color:var(--ink);animation:akin .35s ease both}
#ak-guide .m.u{align-self:flex-end;max-width:88%;padding:10px 14px;font:500 11px/1.4 Inter,sans-serif;font-style:normal;letter-spacing:.14em;text-transform:uppercase;color:#0f1d4c;background:#e9ebf0;border-color:transparent}
#ak-guide .m a{color:var(--ink);text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--champ)}
#ak-guide .m.ty{display:flex;gap:5px;width:max-content;padding:14px 16px}
#ak-guide .m.ty i{width:6px;height:6px;border-radius:50%;background:var(--soft);animation:akd 1.1s infinite}
#ak-guide .m.ty i:nth-child(2){animation-delay:.15s}#ak-guide .m.ty i:nth-child(3){animation-delay:.3s}
@keyframes akd{0%,60%,100%{opacity:.3;transform:none}30%{opacity:1;transform:translateY(-3px)}}
@keyframes akin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
#ak-guide .op{display:flex;flex-direction:column;border:1px solid var(--rule);border-radius:14px;background:var(--card);overflow:hidden;animation:akin .35s ease both}
#ak-guide .op button{display:flex;justify-content:space-between;align-items:center;gap:12px;width:100%;text-align:left;padding:15px 16px;background:none;border:0;border-top:1px solid var(--rule);font:500 11px/1.35 Inter,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--champ);transition:background .2s,color .2s}
#ak-guide .op button:first-child{border-top:0}
#ak-guide .op button::after{content:"›";font-size:16px;line-height:1;color:var(--dim)}
#ak-guide .op button:hover,#ak-guide .op button:focus-visible{background:rgba(245,242,235,.12);outline:0}
#ak-guide .op button:active,#ak-guide .op button.on{background:#f5f2eb;color:#14246a}
#ak-guide .op button.on::after{color:#14246a}
#ak-guide .op.done button:not(.on){opacity:.4;pointer-events:none}
#ak-guide .op.done button.on{pointer-events:none}
#ak-guide .lead{display:flex;flex-direction:column;gap:9px;padding:14px 16px;border:1px solid var(--rule);border-radius:14px;background:var(--card);animation:akin .35s ease both}
#ak-guide .lead input{width:100%;height:44px;padding:0 14px;border-radius:10px;border:1px solid var(--rule);background:rgba(8,16,48,.35);color:var(--ink);font:16px Inter,sans-serif}
#ak-guide .lead input::placeholder{color:var(--dim)}
#ak-guide .lead input:focus{outline:0;border-color:#f5f2eb}
#ak-guide .lead button{height:44px;border-radius:10px;border:1px solid #c9ced3;background:linear-gradient(180deg,#f5f2eb,#d8d4ca);color:#14246a;font:600 11px/1 Inter,sans-serif;letter-spacing:.18em;text-transform:uppercase}
#ak-guide .lead button:disabled{opacity:.6}
#ak-guide .lead small{font-size:12px;line-height:1.4;color:var(--soft)}
#ak-guide .fm{display:flex;gap:10px;padding:12px 18px 6px;flex:none}
#ak-guide .fm input{flex:1;min-width:0;height:46px;padding:0 14px;border-radius:12px;border:1px solid var(--rule);background:rgba(255,255,255,.06);color:var(--ink);font:16px Inter,sans-serif}
#ak-guide .fm input::placeholder{color:var(--dim)}
#ak-guide .fm input:focus{outline:0;border-color:#f5f2eb;box-shadow:0 0 0 3px rgba(245,242,235,.14)}
#ak-guide .fm button{flex:none;height:46px;padding:0 20px;border-radius:12px;border:1px solid #b8bbc0;background:linear-gradient(180deg,#2b303c,#10131b);color:#f5f2eb;font:600 12px/1 Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;box-shadow:inset 0 1px 0 rgba(255,255,255,.18)}
#ak-guide .fm button:hover{background:linear-gradient(180deg,#3a4050,#171b25)}
#ak-guide .fm button:focus-visible{outline:2px solid #f5f2eb;outline-offset:2px}
#ak-guide .nt{margin:0;padding:4px 18px 14px;font-size:11px;line-height:1.4;color:var(--dim);flex:none}
@media (max-width:560px){
#ak-guide{right:8px;left:8px;bottom:max(8px,env(safe-area-inset-bottom,0px))}
#ak-guide .lc{margin-left:auto}
#ak-guide .pn{width:100%;height:min(86dvh,calc(100dvh - 16px))}
#ak-guide .who strong{font-size:22px}
#ak-guide .m{font-size:17px}
}
@media (prefers-reduced-motion:reduce){#ak-guide *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media print{#ak-guide{display:none}}

</style>
