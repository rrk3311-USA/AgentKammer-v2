<aside class="guide" id="guide" aria-label="Guide">
  <button class="launch" type="button" id="guide-launch" aria-expanded="false" aria-controls="guide-panel">
    <span class="launch-avatar" aria-hidden="true"><img src="/images/guide-avatar.webp" alt="" width="64" height="64" /></span><span class="dot" aria-hidden="true"></span><span class="launch-text"><b>Live guide</b><small>Ask · Explore · Get insights</small></span>
  </button>

  <div class="panel" id="guide-panel" hidden>
    <div class="top">
      <span class="title">Agent Kammer</span>
      <button class="close" type="button" id="guide-close" aria-label="Minimize the guide">Minimize</button>
    </div>

    <div class="who">
      <span class="avatar" aria-hidden="true">
        <img class="mark" src="/images/guide-avatar.webp" alt="" width="60" height="60" />
      </span>
      <span class="names">
        <strong>Your Manhattan Guide</strong>
        <span class="status"><i aria-hidden="true"></i>Online now</span>
      </span>
    </div>

    <div class="progress" aria-live="polite">
      <div class="track" aria-hidden="true"><span id="guide-fill"></span></div>
      <p class="label" id="guide-step">Starting the conversation</p>
    </div>

    <div class="stage" id="guide-stage"></div>

    <div class="log" id="guide-log" role="log" aria-live="polite"></div>

    <form class="form" id="guide-form">
      <label class="sr" for="guide-input">Your message</label>
      <input id="guide-input" type="text" maxlength="1000" placeholder="Ask me anything..." autocomplete="off" />
      <button class="send" type="submit" id="guide-send">Send</button>
    </form>
    <p class="err" id="guide-err" hidden></p>
    <p class="note">AI guide. Our team reads chats you choose to save.</p>
  </div>
</aside>

<script>
  // Inside another page's frame (the guide showing a site page), stay out of the way.
  if (window.top !== window) {
    document.getElementById("guide")?.remove();
  } else {
    const launch = document.getElementById("guide-launch") as HTMLButtonElement;
    const panel = document.getElementById("guide-panel") as HTMLElement;
    const close = document.getElementById("guide-close") as HTMLButtonElement;
    const stage = document.getElementById("guide-stage") as HTMLElement;
    const log = document.getElementById("guide-log") as HTMLElement;
    const form = document.getElementById("guide-form") as HTMLFormElement;
    const input = document.getElementById("guide-input") as HTMLInputElement;
    const send = document.getElementById("guide-send") as HTMLButtonElement;
    const err = document.getElementById("guide-err") as HTMLElement;
    const fill = document.getElementById("guide-fill") as HTMLElement;
    const stepLabel = document.getElementById("guide-step") as HTMLElement;

    type Block =
      | { type: "text"; text: string }
      | { type: "slide"; title: string; points: string[]; takeaway?: string; offer?: { label: string; path: string } }
      | { type: "page"; path: string; anchor?: string; reason: string }
      | { type: "choices"; question: string; options: string[] }
      | { type: "steps"; items: string[] };

    // What the server needs to remember: visitor messages and a plain summary of what was shown.
    const history: { role: "user" | "assistant"; content: string }[] = [];
    let busy = false;
    let opened = false;

    // The triage has three stages, matching the Situation Assessment: what changed, where you stand,
    // and your next step. Each visual moves the bar forward; it never moves back.
    const STEPS = ["What changed", "Where you stand", "Your next step"];
    let reached = -1;
    function advance(to: number) {
      if (to <= reached) return;
      reached = to;
      fill.style.width = `${((reached + 1) / STEPS.length) * 100}%`;
      stepLabel.textContent = `Step ${reached + 1} of ${STEPS.length} · ${STEPS[reached]}`;
    }

    // Preview the looks with ?guide-style=gold|navy|platinum|ivory|night|royal. Royal is the default.
    const style = new URLSearchParams(location.search).get("guide-style");
    const aside = document.getElementById("guide") as HTMLElement;
    aside.dataset.style = style || "royal";

    const OPENED_KEY = "guide-opened";
    const seenThisSession = () => {
      try {
        return sessionStorage.getItem(OPENED_KEY) === "1";
      } catch {
        return false;
      }
    };
    const markSeen = () => {
      try {
        sessionStorage.setItem(OPENED_KEY, "1");
      } catch {
        /* private windows can refuse storage; the guide still works */
      }
    };

    function setOpen(open: boolean) {
      panel.hidden = !open;
      launch.hidden = open;
      launch.setAttribute("aria-expanded", String(open));
      if (open) input.focus({ preventScroll: true });
    }

    function say(role: "user" | "bot", text: string) {
      const p = document.createElement("p");
      p.className = `msg ${role}`;
      p.textContent = text;
      log.append(p);
      log.scrollTop = log.scrollHeight;
    }

    // Three dots in the log while the guide is "writing", so the visitor sees it is live.
    let typingNode: HTMLElement | null = null;
    function typing(on: boolean) {
      if (on && !typingNode) {
        typingNode = document.createElement("p");
        typingNode.className = "msg bot typing";
        typingNode.setAttribute("aria-label", "The guide is typing");
        typingNode.innerHTML = "<span></span><span></span><span></span>";
        log.append(typingNode);
        log.scrollTop = log.scrollHeight;
      } else if (!on && typingNode) {
        typingNode.remove();
        typingNode = null;
      }
    }

    function el(tag: string, className: string, text?: string) {
      const node = document.createElement(tag);
      node.className = className;
      if (text) node.textContent = text;
      return node;
    }

    // Each visual replaces the stage, so the visitor always sees one thing at a time.
    function show(block: Block) {
      stage.replaceChildren();
      if (block.type === "choices") advance(0);
      if (block.type === "page" || block.type === "slide") advance(1);
      if (block.type === "steps") advance(2);

      if (block.type === "slide") {
        const card = el("div", "slide");
        card.append(el("h3", "", block.title));
        const list = el("ul", "points");
        for (const point of block.points) list.append(el("li", "", point));
        card.append(list);
        if (block.takeaway) card.append(el("p", "takeaway", block.takeaway));
        if (block.offer) {
          const offer = el("a", "offer", block.offer.label) as HTMLAnchorElement;
          offer.href = block.offer.path;
          card.append(offer);
        }
        stage.append(card);
      }

      if (block.type === "page") {
        const frame = document.createElement("iframe");
        frame.className = "frame";
        frame.title = block.reason;
        frame.src = block.path;
        frame.addEventListener("load", () => {
          // Same site, so the guide can tidy the page and scroll to the section it is talking about.
          const doc = frame.contentDocument;
          if (!doc) return;
          doc.querySelectorAll("header, footer").forEach((node) => ((node as HTMLElement).style.display = "none"));
          if (!block.anchor) return;
          doc.getElementById(block.anchor)?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
        const caption = el("p", "caption", block.reason);
        const open = el("a", "open", "Open this page");
        open.href = block.path;
        stage.append(frame, caption, open);
      }

      if (block.type === "choices") {
        const wrap = el("div", "choices");
        wrap.append(el("p", "question", block.question));
        const row = el("div", "options");
        for (const option of block.options) {
          const btn = el("button", "option", option) as HTMLButtonElement;
          btn.type = "button";
          btn.addEventListener("click", () => ask(option));
          row.append(btn);
        }
        wrap.append(row);
        stage.append(wrap);
      }

      if (block.type === "steps") {
        const wrap = el("div", "steps");
        wrap.append(el("p", "question", "Next steps"));
        const list = el("ol", "");
        for (const item of block.items) list.append(el("li", "", item));
        wrap.append(list);
        stage.append(wrap);
      }
    }

    // Plays a reply in order: spoken lines go to the log, each visual takes the stage in turn.
    // Slides and pages hold on screen long enough to read before the guide moves on.
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    async function play(blocks: Block[]) {
      for (const block of blocks) {
        if (block.type === "text") {
          typing(true);
          await wait(700);
          typing(false);
          say("bot", block.text);
          await wait(300);
        } else {
          show(block);
          if (block.type === "slide" || block.type === "page") await wait(4500);
        }
      }
    }

    function pageContext() {
      const q = new URLSearchParams(location.search);
      const keys = ["situation", "decision", "building", "area"] as const;
      return Object.fromEntries(keys.map((k) => [k, q.get(k) ?? ""]).filter(([, v]) => v));
    }

    async function request(messages: typeof history, opening: boolean) {
      if (busy) return;
      busy = true;
      send.disabled = true;
      err.hidden = true;
      typing(true);
      try {
        const res = await fetch("/api/chat", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ messages, opening, page: location.pathname, context: pageContext() }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error ?? "Something went wrong.");
        typing(false);
        await play(data.blocks as Block[]);
        history.push({ role: "assistant", content: data.summary || "[replied]" });
      } catch (error) {
        // A visitor never sees a server message. They get a way to reach a person instead.
        err.textContent = "The guide is unavailable right now. ";
        const contact = document.createElement("a");
        contact.href = "/contact";
        contact.textContent = "Write to the team";
        err.append(contact, " and a person will reply.");
        err.hidden = false;
      } finally {
        typing(false);
        busy = false;
        send.disabled = false;
      }
    }

    // Opens the conversation when the visitor asks for it.
    function open() {
      if (opened) return;
      opened = true;
      markSeen();
      setOpen(true);
      request([], true);
    }

    function ask(text: string) {
      if (busy) return;
      history.push({ role: "user", content: text });
      say("user", text);
      request([...history], false);
    }

    // The header menu can hand over a question from the same page.
    window.addEventListener("guide:ask", (e) => {
      const text = String((e as CustomEvent).detail || "").trim().slice(0, 300);
      if (!text) return;
      if (!opened) {
        opened = true;
        markSeen();
      }
      setOpen(true);
      ask(text);
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      input.value = "";
      ask(text);
    });

    launch.addEventListener("click", () => {
      if (!opened) open();
      else setOpen(true);
    });
    close.addEventListener("click", () => {
      setOpen(false);
      sendTranscript();
    });

    // Email the team a transcript when the visitor minimizes or leaves, once per new message.
    const session = Math.random().toString(36).slice(2, 10);
    let sentCount = 0;
    function sendTranscript() {
      const userCount = history.filter((h) => h.role === "user").length;
      if (!userCount || userCount === sentCount) return;
      sentCount = userCount;
      try {
        navigator.sendBeacon("/api/transcript", JSON.stringify({ turns: history, page: location.pathname, session }));
      } catch {
        /* the transcript is a courtesy copy; the chat itself is unaffected */
      }
    }
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") sendTranscript();
    });
    window.addEventListener("pagehide", sendTranscript);

    // The guide never opens on its own. It opens when the visitor clicks Live Guide or asks from the menu.
  }
</script>

<style is:global>
  /* Each look is a set of tokens. The markup never changes. Royal is the default. */
  #guide {
    --g-ink: #3A2F20;
    --g-body: #FBF6EA;
    --g-paper: linear-gradient(180deg, #FFFDF7 0%, #F6EEDB 100%);
    --g-accent: #5C4424;
    --g-rule: #B08D57;
    --g-soft: rgba(176, 141, 87, 0.45);
    --g-glow: rgba(92, 68, 36, 0.26);
    --g-head: transparent;
    --g-head-ink: #5C4424;
    --g-launch: linear-gradient(180deg, #F7EDD2, #D9B979);
    --g-launch-ink: #5C4424;
    --g-launch-rule: #B08D57;
    --g-choice: transparent;
    --g-choice-ink: #5C4424;
    --g-text: #FFFDF7;
    --g-frame-inset: inset 0 0 0 4px #FBF6EA, inset 0 0 0 5px rgba(176, 141, 87, 0.45);
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: max(16px, env(safe-area-inset-bottom, 0px));
    z-index: 60;
    font-family: var(--sans);
    color: var(--g-ink);
  }
  #guide[data-style="navy"] {
    --g-ink: #2A3447; --g-body: #F5F2EB; --g-paper: #F5F2EB; --g-accent: #2A3447; --g-rule: #8E949B; --g-soft: rgba(42, 52, 71, 0.22); --g-glow: rgba(42, 52, 71, 0.3);
    --g-head: linear-gradient(115deg, transparent 0%, rgba(245, 242, 235, 0.16) 24%, transparent 44%), repeating-linear-gradient(90deg, rgba(245, 242, 235, 0.07) 0 1px, transparent 1px 6px), #2A3447;
    --g-head-ink: #F5F2EB; --g-launch: linear-gradient(115deg, transparent 0%, rgba(245, 242, 235, 0.16) 24%, transparent 44%), repeating-linear-gradient(90deg, rgba(245, 242, 235, 0.07) 0 1px, transparent 1px 6px), #2A3447; --g-launch-ink: #F5F2EB; --g-launch-rule: #B08D57;
    --g-choice: #FFFFFF; --g-choice-ink: #2A3447; --g-frame-inset: none;
  }
  #guide[data-style="platinum"] {
    --g-ink: #2F3136; --g-body: #F7F8F9; --g-paper: #F7F8F9; --g-accent: #2A3447; --g-rule: #8E949B; --g-soft: rgba(110, 116, 124, 0.3); --g-glow: rgba(42, 52, 71, 0.22);
    --g-head: repeating-linear-gradient(90deg, rgba(42, 52, 71, 0.12) 0 1px, transparent 1px 7px), linear-gradient(180deg, #F6F7F8, #D5D9DE);
    --g-head-ink: #2A3447; --g-launch: linear-gradient(180deg, #F6F7F8 0%, #D5D9DE 52%, #B9BEC5 100%); --g-launch-ink: #2A3447; --g-launch-rule: #8E949B;
    --g-choice: #FFFFFF; --g-choice-ink: #2A3447; --g-frame-inset: inset 0 0 0 4px #F7F8F9, inset 0 0 0 5px rgba(160, 166, 174, 0.45);
  }
  #guide[data-style="ivory"] {
    --g-ink: #2F2A22; --g-body: #FBF8F1; --g-paper: #FBF8F1; --g-accent: #2A3447; --g-rule: #D8D1C7; --g-soft: #E7E0D3; --g-glow: rgba(47, 42, 34, 0.14);
    --g-head: transparent; --g-head-ink: #2A3447; --g-launch: #2A3447; --g-launch-ink: #F5F2EB; --g-launch-rule: #2A3447;
    --g-choice: transparent; --g-choice-ink: #2A3447; --g-frame-inset: none;
  }
  #guide[data-style="night"] {
    --g-ink: #F5F2EB; --g-body: #1E2636; --g-paper: linear-gradient(180deg, #232D40 0%, #1A2232 100%); --g-accent: #D9B979; --g-rule: #B08D57; --g-soft: rgba(176, 141, 87, 0.4); --g-glow: rgba(0, 0, 0, 0.45);
    --g-head: transparent; --g-head-ink: #D9B979; --g-launch: linear-gradient(180deg, #2A3447, #161C28); --g-launch-ink: #D9B979; --g-launch-rule: #B08D57;
    --g-choice: transparent; --g-choice-ink: #D9B979; --g-text: #2A3447; --g-frame-inset: inset 0 0 0 4px #1E2636, inset 0 0 0 5px rgba(176, 141, 87, 0.4);
  }
  /* A private concierge: ivory stock, deep navy type, restrained champagne hairlines. No texture. */
  #guide[data-style="royal"] {
    --g-ink: #1E2A3A; --g-body: #FBF8F1; --g-paper: linear-gradient(180deg, #FBF8F1 0%, #F3EDE0 100%); --g-accent: #2A3447; --g-rule: #B08D57; --g-soft: rgba(176, 141, 87, 0.35); --g-glow: rgba(30, 42, 58, 0.22);
    --g-head: transparent; --g-head-ink: #2A3447; --g-launch: linear-gradient(115deg, transparent 0%, rgba(245, 242, 235, 0.16) 24%, transparent 44%), repeating-linear-gradient(90deg, rgba(245, 242, 235, 0.16) 0 1px, transparent 1px 7px), #2A3447; --g-launch-ink: #F5F2EB; --g-launch-rule: #101318;
    --g-choice: #FFFFFF; --g-choice-ink: #2A3447; --g-text: #FFFFFF; --g-frame-inset: none;
  }
  #guide[data-style="royal"] .launch { height: 42px; padding: 0 46px 0 16px; gap: 11px; border: 1px solid rgba(245, 242, 235, 0.3); border-radius: 999px; background: rgba(27, 34, 50, 0.82); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); letter-spacing: 0; text-transform: none; box-shadow: 0 10px 22px var(--g-glow); }
        #guide .launch-text { display: grid; gap: 3px; text-align: left; padding-left: 12px; border-left: 1px solid rgba(245, 242, 235, 0.55); }
  #guide .launch-text b { font: 500 15px/1 var(--serif); letter-spacing: 0.12em; text-transform: uppercase; color: #F5F2EB; }
  #guide .launch-text small { display: none; }
  #guide[data-style="royal"] .launch-avatar { top: 50%; bottom: auto; right: 8px; width: 30px; height: 30px; margin-top: -15px; overflow: hidden; border-radius: 50%; background: linear-gradient(180deg, #E9E4D8, #CFC8B8); box-shadow: 0 0 0 1px rgba(176, 141, 87, 0.7); }
  #guide[data-style="royal"] .launch-avatar img { width: 120%; height: 120%; margin: 10% 0 0 -6%; object-fit: cover; object-position: 50% 12%; filter: none; }
  #guide[data-style="royal"] .dot { width: 9px; height: 9px; box-shadow: 0 0 6px #4FA86A; }
  #guide[data-style="royal"] .panel { width: min(340px, calc(100vw - 32px)); border-radius: 18px; }
  #guide[data-style="royal"] .top { border-radius: 17px 17px 0 0; }
  /* Messages read like the rows of a printed card: serif lines on hairline rules, no bubbles. */
  #guide[data-style="royal"] .msg { max-width: 100%; padding: 10px 0; border: 0; border-bottom: 1px solid var(--g-soft); background: transparent; color: var(--g-ink); font: italic 400 17px/1.4 var(--serif); }
  #guide[data-style="royal"] .msg.user { align-self: stretch; background: transparent; color: var(--g-accent); border: 0; border-bottom: 1px solid var(--g-soft); font: 500 11px/1.4 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; }
  #guide[data-style="royal"] .msg.typing { border: 0; }
  /* Chat cards follow the printed Property Assessment card: cream stock, serif, a cut corner, no window chrome. */
  #guide[data-style="royal"] .slide { background: linear-gradient(180deg, #FFFFFF 0%, #F8F4EA 100%); border: 1px solid var(--g-rule); padding: 22px 22px 20px; clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%); box-shadow: 0 10px 24px var(--g-glow); }
  #guide[data-style="royal"] .slide h3 { font: 500 26px/1.1 var(--serif); color: var(--g-accent); }
  #guide[data-style="royal"] .points { font: italic 400 16px/1.5 var(--serif); color: var(--g-ink); }
  #guide[data-style="royal"] .question { font: 400 22px/1.2 var(--serif); }
  #guide[data-style="royal"] .option { background: transparent; border: 1px solid var(--g-rule); color: var(--g-accent); font: 500 10px/1.2 var(--sans); letter-spacing: 0.18em; text-transform: uppercase; }
  #guide[data-style="royal"] .option:hover { background: var(--g-accent); color: #FBF9F4; }
  #guide[data-style="royal"] .steps ol { font: italic 400 16px/1.5 var(--serif); color: var(--g-ink); }

  #guide .launch { display: inline-flex; align-items: center; gap: 12px; white-space: nowrap; height: 48px; padding: 0 46px 0 22px; border: 1px solid var(--g-launch-rule); background: var(--g-launch); color: var(--g-launch-ink); font: 500 12px/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 10px 24px var(--g-glow); }
  #guide .launch:hover { opacity: 0.9; }
  #guide .launch { position: relative; }
  /* The medallion sits on the top right corner of the bar, half over the edge. */
  #guide .launch-avatar { position: absolute; top: -40px; right: 2px; width: 38px; height: 51px; pointer-events: none; }
  #guide .launch-avatar img { display: block; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.45)); }
  #guide .launch[hidden] { display: none; }

  /* Royal conversation: quiet header, a medallion for a face, one hairline above the talk, a composer that does not shout. */
  #guide[data-style="royal"] .panel { border-color: #2F3136; }
  #guide[data-style="royal"] .top { border-bottom: 0; padding: 16px 18px 4px; }
  #guide[data-style="royal"] .title { font-weight: 600; letter-spacing: 0.12em; }
  #guide[data-style="royal"] .close { height: auto; padding: 3px 0; border: 0; border-bottom: 1px solid #2F3136; background: transparent; color: #2F3136; font: 500 10px/1 var(--sans); letter-spacing: 0.1em; text-transform: uppercase; }
  #guide[data-style="royal"] .close:hover { background: transparent; color: var(--g-accent); border-bottom-color: var(--g-rule); }
  #guide[data-style="royal"] .who { gap: 14px; padding: 12px 18px 14px; }
  #guide[data-style="royal"] .names { gap: 6px; }
  #guide[data-style="royal"] .names strong { font-size: 22px; }
  #guide[data-style="royal"] .status { opacity: 1; color: #5C636B; }
  #guide[data-style="royal"] .progress { padding: 0 18px 10px; }
  #guide[data-style="royal"] .track { height: 1px; background: var(--g-soft); }
  #guide[data-style="royal"] .label { letter-spacing: 0.1em; color: #5C636B; }
  /* The inner chat stays as it was: a recessed silver well with the small square texture and silver text. */
  #guide[data-style="royal"] .stage,
  #guide[data-style="royal"] .log { margin: 0 14px; border: 0; background: radial-gradient(rgba(42, 52, 71, 0.05) 1px, transparent 1px) 0 0 / 4px 4px, linear-gradient(135deg, #EEF0F2 0%, #C9CED3 46%, #E4E7EA 100%); box-shadow: inset 0 2px 10px rgba(42, 52, 71, 0.16), inset 0 -2px 10px rgba(42, 52, 71, 0.12); }
  #guide[data-style="royal"] .msg, #guide[data-style="royal"] .stage p, #guide[data-style="royal"] .points li { color: #5C636B; }
  #guide[data-style="royal"] .form { padding: 12px 18px 8px; }
  #guide[data-style="royal"] .form input { border: 1px solid #2F3136; border-radius: 0; background: #FFFFFF; color: var(--g-ink); padding-left: 14px; }
  #guide[data-style="royal"] .form input::placeholder { color: #7A8088; }
  #guide[data-style="royal"] .form input:focus-visible { outline: 0; border-color: #1E2A3A; box-shadow: 0 0 0 3px rgba(42, 52, 71, 0.14); }
