---
interface Crumb { label: string; href?: string }
interface Props {
  crumbs: Crumb[];
  eyebrow: string;
  title: string;
  lead: string;
  decide: string[];
  recommendation: string;
  cta: { href: string; label: string };
  banner?: { src: string; alt: string };
}
const { crumbs, eyebrow, title, lead, decide, recommendation, cta, banner } = Astro.props;
---
<article class="wrap nb gd">
  <nav class="crumb" aria-label="Breadcrumb">
    {crumbs.map((c, i) => (
      <>
        {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
        {i < crumbs.length - 1 && <i aria-hidden="true">/</i>}
      </>
    ))}
  </nav>
  {banner && (
    <figure style="margin: 28px 0 28px">
      <img src={banner.src} alt={banner.alt} width="2000" height="1250" style="display: block; width: 100%; height: auto; aspect-ratio: 2000 / 625; object-fit: cover" decoding="async" />
    </figure>
  )}
  <header>
    <div class="eyebrow">{eyebrow}</div>
    <h1>{title}</h1>
    <p class="lede">{lead}</p>
  </header>

  <section class="nb-decide" aria-labelledby="gb-d">
    <h2 id="gb-d">Decide first</h2>
    <ol>{decide.map((d) => <li>{d}</li>)}</ol>
  </section>

  <section class="nb-rec" aria-labelledby="gb-r">
    <div class="k" id="gb-r">Recommendation</div>
    <p>{recommendation}</p>
  </section>

  <p class="gd-note">General information, not legal, tax or financial advice. Confirm details with your attorney.</p>

  <div class="gcta">
    <p>Want a read on your own situation?</p>
    <div class="btns">
      <a class="btn" href={cta.href}>{cta.label} <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
      <a class="btn ghost" href="/guides">All guides <svg class="ic" aria-hidden="true"><use href="#ar" /></svg></a>
    </div>
  </div>
</article>
